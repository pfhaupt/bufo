import "prelude.bufo";
import "./module.bufo";
import "./bindings.bufo";

struct LLVMPassBuilderOptions {
    ref: LLVM::PassBuilderOptionsRef;
}

@trace func createPassBuilderOptions() -> LLVMPassBuilderOptions {
    let v = LLVM::CreatePassBuilderOptions();
    assert(!LLVM::isNull(v), "Could not create Pass Builder Options");
    return LLVMPassBuilderOptions { ref: v };
}
@trace func disposePassBuilderOptions(opt: LLVMPassBuilderOptions) {
    LLVM::DisposePassBuilderOptions(opt.ref);
}
@trace func setVerifyEach(opt: LLVMPassBuilderOptions, verify: LLVMBool) {
    LLVM::PassBuilderOptionsSetVerifyEach(opt.ref, verify);
}
@trace func setDebugLogging(opt: LLVMPassBuilderOptions, debug: LLVMBool) {
    LLVM::PassBuilderOptionsSetDebugLogging(opt.ref, debug);
}
@trace func setAAPipeline(opt: LLVMPassBuilderOptions, pipeline: &char) {
    LLVM::PassBuilderOptionsSetAAPipeline(opt.ref, pipeline);
}
@trace func setLoopInterleaving(opt: LLVMPassBuilderOptions, interleave: LLVMBool) {
    LLVM::PassBuilderOptionsSetLoopInterleaving(opt.ref, interleave);
}
@trace func setLoopVectorization(opt: LLVMPassBuilderOptions, vectorize: LLVMBool) {
    LLVM::PassBuilderOptionsSetLoopVectorization(opt.ref, vectorize);
}
@trace func setSLPVectorization(opt: LLVMPassBuilderOptions, vectorize: LLVMBool) {
    LLVM::PassBuilderOptionsSetSLPVectorization(opt.ref, vectorize);
}
@trace func setLoopUnrolling(opt: LLVMPassBuilderOptions, unroll: LLVMBool) {
    LLVM::PassBuilderOptionsSetLoopUnrolling(opt.ref, unroll);
}
@trace func setForgetAllSCEVInLoopUnroll(opt: LLVMPassBuilderOptions, forget: LLVMBool) {
    LLVM::PassBuilderOptionsSetForgetAllSCEVInLoopUnroll(opt.ref, forget);
}
@trace func setLicmMssaOptCap(opt: LLVMPassBuilderOptions, cap: u32) {
    LLVM::PassBuilderOptionsSetLicmMssaOptCap(opt.ref, cap);
}
@trace func setLicmMssaNoAccForPromotionCap(opt: LLVMPassBuilderOptions, cap: u32) {
    LLVM::PassBuilderOptionsSetLicmMssaNoAccForPromotionCap(opt.ref, cap);
}
@trace func setCallGraphProfile(opt: LLVMPassBuilderOptions, profile: LLVMBool) {
    LLVM::PassBuilderOptionsSetCallGraphProfile(opt.ref, profile);
}
@trace func setMergeFunctions(opt: LLVMPassBuilderOptions, merge: LLVMBool) {
    LLVM::PassBuilderOptionsSetMergeFunctions(opt.ref, merge);
}
@trace func setInlinerThreshold(opt: LLVMPassBuilderOptions, threshold: i32) {
    LLVM::PassBuilderOptionsSetInlinerThreshold(opt.ref, threshold);
}
