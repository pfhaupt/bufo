
import "prelude.bufo";
import "libc.bufo";
import "tracy.bufo";
import "substr.bufo";

// NOTE(2026-06-23): Technically -> usize is UB, but as TracyCZoneCtx is 8 bytes anyway it spares
//                   us the struct ABI :^)
func traceEnter(file: &char, fileLen: usize, line: usize, fn: &char, fnLen: usize, color: usize) -> usize {
    let source = newSubStr(file, 0, fileLen);
    let function = newSubStr(fn, 0, fnLen);
    let ctx = tracy::begin_zone(source, function, color as u32);
    return *(&ctx as &usize);
}
func traceLeave(file: &char, fileLen: usize, line: usize, fn: &char, fnLen: usize, _ctx: usize) {
    let ctx = *(&_ctx as &tracy::TracyCZoneCtx);
    tracy::end_zone(ctx);
}
