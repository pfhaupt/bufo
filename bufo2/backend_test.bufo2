/*
 * Plan:
 * - Userspace Backends
 *   - Module support
 *   - Oh shit, Instructions are Unions
 *     - Implement Unions
 *       - Oh shit, binary operators are also userspace
 *         - Implement better metaprogramming
 *           - Module support, again
 *             - Declaring normal modules should be easy enough
 *           - `#if` and variations of it
 *           - Somehow allow users to get handles of $T and such at compile time
 *             - Given that everything is a &AST or &Type, we may just pass the pointer?
 *           - Somehow tell a function that it's an internal compiler function
 *             and should call a bufo1 function (WE ARE HERE)
 *           - Somehow be able to call a bufo2 function from bufo1,
 *             for example LLVM_Backend.initialize()
 * - Better comptime system
 *   - Allow users to mark functions as `@pure` or something, which would be verified by the
 *     compiler, and then allows implicit comptime usage in stuff like `#if foo()`
 *     - This is particularly relevant because all binary operations desugar to function calls so
 *       we currently couldnt do legit stuff like `#if OS == .WIN`
 */

struct Foo {
    n: i32;
    a: i64;
}

union Option($T) {
    None;
    Some($T);
}

func is_zero(n: $T) -> bool {
    if (n == 0) return true;
    return false;
}

type Stuff($n) {
    n: #if #run is_zero(0 as $n) $n else i64;
    Value(i32);
}

func stuff() {
    let s: Stuff(i32) = blank;
    let n: i32 = s.n;
}

func sizeof(t: ^$T) -> u64 {
    let a: t = blank;
    let b: t = blank;
    let d = &b - &a;
    return d as u64;
}

func foo(t: $T) -> i32 {
    comptime cond = sizeof($T) == 4;
    #if cond return 1 else return 0;
}

type Structure {
    n: i64;
    m: i64;
}

func needle(a: i32, b: Structure, c: i64, d: *i64) -> i64 {
    #assert a == 42, "needle: a is not 42";
    #assert c == 345, "needle: c is not 345";
    #assert *d == 912, "needle: d is not 912";
    if (b.n != 0) return 2;
    if (b.m != 0) return 3;
    *d = 123;
    return c;
}

func main() {
    #run {
        let n: i32 = 1;
        let a = foo(n);
        #assert a == 1, "i32 is 4 bytes";
        let m: i64 = 1;
        let b = foo(m);
        #assert b == 0, "i64 is not 4 bytes";
    };
    #run {
        let some0: Option(i32) = blank;
        let stuff: Stuff(i64) = blank;
        let size = sizeof(^stuff);
        #assert size == 16;

        let n: i32 = 69;
        let some1 = Option(i32).Some(n);
        let some2: Option(i32) = .Some(n);
        let none1: Option(i32) = .None;
        let none2: Option(i32) = Option(i32).None;
        some2 = .None;
        none2 = .Some(n);

        // #assert some1 == .Some;
        // #assert some2 == .None;
        // #assert none1 == .None;
        // #assert none2 != .None;
        // #debug;

        // Bonus:
        // let stuff1: Stuff = blank; // warning: Initializing type with variants with blank
        // stuff1.n = 12;
        // stuff1 = .Value(n); // works but sets n to 0
        // #assert stuff1.n == 0, "stuff1.n is not 0";
        // stuff1 = .{ n: 12, Value(n) }; // set fields accordingly, infer struct type
        // stuff1 = Stuff { n: 12, Value(n) }; // explicit initialization
        // #assert stuff1.n == 12, "stuff1.n is not 12 part 1";

        // let stuff2 = Stuff { n: 13, Value(n) };
        // #assert stuff1.n == 12, "stuff1.n is not 12 part 2";
        // stuff1 = .{ Value(n), ..stuff2 }; // copy stuff2 to stuff1 and set variant
        // #assert stuff1.n == 13, "stuff1.n is not 13";
    }
}
