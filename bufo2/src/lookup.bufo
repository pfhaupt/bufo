
import "prelude.bufo";
import "list.bufo";
import "hashmap.bufo";
import "substr.bufo";
import "type_info.bufo";
import "string.bufo";

import "../generated/ast.template.bufo";
import "ast.bufo";
import "common.bufo";
import "type.bufo";

struct Variable {
    origin: &AST;
    type: &Type;
}

struct Scope_Info {
    variables: GAF_HashMap; // HashMap<SubStr, Variable>
}

func new_stack() -> Scope_Info {
    return Scope_Info {
        variables: new_hashmap_with_substr_key(type_info(Variable)),
    };
}

func get_variable_by_name(scopes: &GAF_List, name: SubStr) -> (Variable, bool) {
    for (let _i: usize = 0; _i < scopes.length; _i = _i + 1) {
        let i = scopes.length - _i - 1;
        let _stack = get_ref_raw(scopes, i) as &Scope_Info;
        let elem = get(&_stack.variables, name);
        if (elem.ptr != null) return (elem as Variable, true);
    }
    return (blank, false);
}

union Lookup {
    TypeDecl(TypeDeclLookup),
    Function(FunctionLookup),
}

func new_type_decl_lookup(node: &AST) -> Lookup {
    return Lookup::TypeDecl(TypeDeclLookup {
        node: node
    });
}

func new_function_lookup(node: &AST) -> Lookup {
    let overloads = new_GAF_List(type_info(&AST));
    push(&overloads, node);
    return Lookup::Function(FunctionLookup {
        overloads: overloads,
    });
}

struct TypeDeclLookup {
    node: &AST;
}

struct FunctionLookup {
    overloads: GAF_List; // List<&AST>
}

struct SymbolLookup {
    type_decls: GAF_HashMap; // HashMap<SubStr, Lookup>
    functions: GAF_HashMap; // HashMap<SubStr, Lookup>
}

let global_lookup: SymbolLookup = blank;
func init_global_lookup() {
    global_lookup = SymbolLookup {
        type_decls: new_hashmap_with_substr_key(type_info(Lookup)),
        functions: new_hashmap_with_substr_key(type_info(Lookup)),
    };
}

func print_global_lookup() {
    foreach(&global_lookup.type_decls, func (key: Data, value: Data) {
        let name = key as SubStr;
        let type_decl_lookup = get_type_decl_by_name(&global_lookup, name);
        let &ASTData::TypeDecl(type_decl_info) = &type_decl_lookup.node.data else {
            unreachable();
        };
        message(dbg(type_decl_lookup.node.loc, "Type `%` defined here.", name));
        foreach(&type_decl_info.monomorphized_instances, func (key: Data, value: Data) {
            let _key = key as String;
            let node = value as &AST;
            message(dbg(node.loc, "  Monomorphized with key `%`", _key));
        });
    });

    foreach(&global_lookup.functions, func (key: Data, value: Data) {
        let name = key as SubStr;
        let fn_lookup = get_functions_by_name(&global_lookup, name);
        foreach(&fn_lookup.overloads, func (elem: Data, name: &SubStr) {
            let node = elem as &AST;
            message(dbg(node.loc, "Function `%` defined here.", *name));
            let ASTData::Function(function) = node.data else {
                unreachable("func node is not a function");
            };
            if (function.state.is_generic) {
                foreach(&function.monomorphized_instances, func (key: Data, value: Data) {
                    let _key = key as String;
                    let node = value as &AST;
                    message(dbg(node.loc, "  Monomorphized with key `%`", _key));
                });
            }
        }, &name);
    });
}

func get_type_decl_by_name(lookup: &SymbolLookup, name: SubStr) -> &TypeDeclLookup {
    let node = get(&lookup.type_decls, name).ptr as &Lookup;
    if (node == null) return null;
    let &Lookup::TypeDecl(sl) = node else {
        return null;
    };
    return &sl;
}
func get_functions_by_name(lookup: &SymbolLookup, name: SubStr) -> &FunctionLookup {
    let node = get(&lookup.functions, name).ptr as &Lookup;
    if (node == null) return null;
    let &Lookup::Function(fl) = node else {
        return null;
    };
    return &fl;
}

func get_global_identifier(name: SubStr) -> (&TypeDeclLookup, &FunctionLookup) {
    return (
        get_type_decl_by_name(&global_lookup, name),
        get_functions_by_name(&global_lookup, name),
    );
}
