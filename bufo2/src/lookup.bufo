
import "prelude.bufo";
import "list.bufo";
import "hashmap.bufo";
import "substr.bufo";
import "type_info.bufo";
import "string.bufo";

import "../generated/ast.template.bufo";
import "ast.bufo";
import "common.bufo";
import "type.bufo";

struct Variable {
    origin: &AST;
    type: &Type;
}

struct Scope_Info {
    variables: GAF_HashMap; // HashMap<SubStr, Variable>
}

func new_stack() -> Scope_Info {
    return Scope_Info {
        variables: new_hashmap_with_substr_key(type_info(Variable)),
    };
}

func get_variable_by_name(scopes: &GAF_List, name: SubStr) -> (Variable, bool) {
    for (let _i: usize = 0; _i < scopes.length; _i = _i + 1) {
        let i = scopes.length - _i - 1;
        let _stack = get_ref_raw(scopes, i) as &Scope_Info;
        let elem = get(&_stack.variables, name);
        if (elem.ptr != null) return (elem as Variable, true);
    }
    return (blank, false);
}

union Lookup {
    TypeDecl(TypeDeclLookup),
    Function(FunctionLookup),
    Module(SymbolLookup),
}

func new_type_decl_lookup(node: &AST) -> Lookup {
    return Lookup::TypeDecl(TypeDeclLookup {
        node: node
    });
}

func new_function_lookup(node: &AST) -> Lookup {
    let overloads = new_GAF_List(type_info(&AST));
    push(&overloads, node);
    return Lookup::Function(FunctionLookup {
        overloads: overloads,
    });
}

func new_module_lookup(node: &AST) -> Lookup {
    let lookup = new_symbol_lookup(node);
    return Lookup::Module(lookup);
}

struct TypeDeclLookup {
    node: &AST;
}

struct FunctionLookup {
    overloads: GAF_List; // List<&AST>
}

struct SymbolLookup {
    original: &AST; // &ASTModule
    type_decls: GAF_HashMap; // HashMap<SubStr, Lookup>
    functions: GAF_HashMap; // HashMap<SubStr, Lookup>
    modules: GAF_HashMap; // HashMap<SubStr, Lookup>
}

func new_symbol_lookup(original: &AST) -> SymbolLookup {
    return SymbolLookup {
        original: original,
        type_decls: new_hashmap_with_substr_key(type_info(Lookup)),
        functions: new_hashmap_with_substr_key(type_info(Lookup)),
        modules: new_hashmap_with_substr_key(type_info(Lookup)),
    };
}

func get_type_decl_by_name(lookup: &SymbolLookup, name: SubStr) -> &TypeDeclLookup {
    let node = get(&lookup.type_decls, name).ptr as &Lookup;
    if (node == null) return null;
    let &Lookup::TypeDecl(sl) = node else {
        return null;
    };
    return &sl;
}
func get_functions_by_name(lookup: &SymbolLookup, name: SubStr) -> &FunctionLookup {
    let node = get(&lookup.functions, name).ptr as &Lookup;
    if (node == null) return null;
    let &Lookup::Function(fl) = node else {
        return null;
    };
    return &fl;
}
func get_module_by_name(lookup: &SymbolLookup, name: SubStr) -> &SymbolLookup {
    let node = get(&lookup.modules, name).ptr as &Lookup;
    if (node == null) return null;
    let &Lookup::Module(ml) = node else {
        return null;
    };
    return &ml;
}

func get_identifier_by_name(mod: &ASTModule, name: SubStr) -> (&TypeDeclLookup, &FunctionLookup, &SymbolLookup) {
    return (
        get_type_decl_by_name(&mod.lookup, name),
        get_functions_by_name(&mod.lookup, name),
        get_module_by_name(&mod.lookup, name),
    );
}
