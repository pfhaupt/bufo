@trace func calculate_size_and_alignment_of_type_decl_variant(variant: &ASTTypeDeclVariant) {
    if (variant.field_offsets.length == 0) {
        for (let i: usize = 0; i < variant.fields.length; i = i + 1) {
            let z: usize = 0;
            push(&variant.field_offsets, z);
        }
    }
    let align: usize = 1;
    let size: usize = 0;
    for (let i: usize = 0; i < variant.fields.length; i = i + 1) {
        let field = get_ref(&variant.fields, i) as &AST;
        assert(field.type != null, "variant field type is null");
        let ft = unwrap_meta_type(field.type, 1);
        let (fs, fa) = get_size_and_alignment(ft);
        if (fa > align) align = fa;
        let field_offset = size;
        size = size + fs;

        let offset: &usize = get_ref_raw(&variant.field_offsets, i);
        *offset = field_offset;

        if (i != variant.fields.length - 1) {
            let nf = get_ref(&variant.fields, i + 1) as &AST;
            let nft = unwrap_meta_type(nf.type, 1);
            let na = get_align(nft);
            size = next_multiple_of(size, na);
        }
    }
    size = next_multiple_of(size, align);

    variant.size_in_bytes = size;
    variant.align_in_bytes = align;
    unregister_monitor(&variant.size_in_bytes);
    unregister_monitor(&variant.align_in_bytes);
}

@trace func calculate_size_and_alignment_of_type_decl(type_decl_info: &ASTTypeDecl) {
    // <fields> <pad> <tag> <pad> <variant>
    let align: usize = 1;
    let size: usize = 0;

    for (let i: usize = 0; i < type_decl_info.fields.length; i = i + 1) {
        let field: &ASTTypeDeclField = get_ref_raw(&type_decl_info.fields, i);
        assert(field.type_node.type != null, "field type is null");

        let field_type = unwrap_meta_type(field.type_node.type, 1);
        let (field_size, field_align) = get_size_and_alignment(field_type);
        if (field_align > align) align = field_align;
        field.offset_in_type = size;
        size = size + field_size;

        if (i != type_decl_info.fields.length - 1) {
            let next_field: &ASTTypeDeclField = get_ref_raw(&type_decl_info.fields, i + 1);
            let next_field_type = unwrap_meta_type(next_field.type_node.type, 1);
            let next_align = get_align(next_field_type);
            size = next_multiple_of(size, next_align);
        }
    }

    if (type_decl_info.variants.length > 0) {
        assert(type_decl_info.variants.length <= 65535, "bro wtf are you doing");
        type_decl_info.tag_offset = size;
        let tag_s: usize = 1;
        let tag_a: usize = 1;
        if (type_decl_info.variants.length >= 256) tag_s = tag_a = 2;

        size = next_multiple_of(size, tag_a);
        size = size + tag_s;

        let max_va: usize = 1;
        let max_vs: usize = 0;
        for (let i: usize = 0; i < type_decl_info.variants.length; i = i + 1) {
            let variant: &ASTTypeDeclVariant = get_ref_raw(&type_decl_info.variants, i);
            calculate_size_and_alignment_of_type_decl_variant(variant);
            let vs = variant.size_in_bytes;
            let va = variant.align_in_bytes;
            if (vs > max_vs) max_vs = vs;
            if (va > max_va) max_va = va;
        }

        size = next_multiple_of(size, max_va);
        size = size + max_vs;
    }

    size = next_multiple_of(size, align);

    type_decl_info.size_in_bytes = size;
    type_decl_info.align_in_bytes = align;
    unregister_monitor(&type_decl_info.tag_offset);
    unregister_monitor(&type_decl_info.size_in_bytes);
    unregister_monitor(&type_decl_info.align_in_bytes);
}

@trace func check_type_decl(node: &AST) {
    let &ASTData::TypeDecl(type_decl_info) = &node.data else {
        unreachable("check_type_decl: Node is not a type_decl");
    };

    let scopes = new_GAF_List(type_info(Scope_Info));
    for (let i: usize = 0; i < type_decl_info.fields.length; i = i + 1) {
        let field: &ASTTypeDeclField = get_ref_raw(&type_decl_info.fields, i);
        let field_state = check_expr(&scopes, field.type_node);
        let type = assert_is_valid(field_state, "TypeDecl Field type is invalid");
        if (type.meta_level == 0) message(fatal(node.loc, "field type is value: %", *type));
    }
    type_decl_info.state.did_check_fields = true;
    unregister_monitor(&type_decl_info.state.did_check_fields);

    for (let i: usize = 0; i < type_decl_info.variants.length; i = i + 1) {
        let variant: &ASTTypeDeclVariant = get_ref_raw(&type_decl_info.variants, i);
        for (let j: usize = 0; j < variant.fields.length; j = j + 1) {
            let field: &&AST = get_ref_raw(&variant.fields, j);
            let field_state = check_expr(&scopes, *field);
            let type = assert_is_valid(field_state, "TypeDecl Variant Field type is invalid");
            if (type.meta_level == 0) message(fatal(node.loc, "variant field type is value: %", *type));
        }
    }
    type_decl_info.state.did_check_variants = true;
    unregister_monitor(&type_decl_info.state.did_check_variants);

    calculate_size_and_alignment_of_type_decl(&type_decl_info);
}

@trace func check_function_return_type(func_state: &ASTFunction) {
    let ret_state = check_expr(&func_state.scopes, func_state.return_type);
    let ret_type = assert_is_valid(ret_state, "check_function_return_type: Return type is invalid");
    let fn = get_parent_function(func_state.return_type);
    let none = create_meta_type(1, PrimType::None);
    if (has_attribute(fn, ASTAttrData::Expand) && !is_equal_to(ret_type, none)) {
        message(error(fn.loc, "Functions marked @expand may not return values."));
    }
}

@trace func check_function_parameters(func_state: &ASTFunction) {
    for (let i: usize = 0; i < func_state.params.length; i = i + 1) {
        let param = get_ref(&func_state.params, i) as &AST;
        check_param(&func_state.scopes, param);
    }
}

@trace func check_param(scopes: &GAF_List, param: &AST) {
    let &ASTData::Param(p_type) = &param.data else {
        unreachable("check_param: Node is not a parameter");
    };
    assert(scopes.length == 1);
    let _last = get_ref_raw(scopes, 0) as &Scope_Info;
    if (contains(&_last.variables, param.origin)) {
        message(todo(param.loc, "check_param: Redefinition of param"));
    } else {
        let param_state = check_expr(scopes, p_type);
        param.type = assert_is_valid(param_state, "check_param: Param type is invalid");
        add(&_last.variables, param.origin, Variable {
            origin: param,
            type: unwrap_meta_type(param.type, 1),
        });
    }
}

@trace func check_block(block: &AST) -> TCState {
    // TODO(2026-04-13): Once we have stuff like #value_of() we can condense BlockExpr and
    //                   BlockVoid into one block in the parser, so we don't have to pass
    //                   null as value here. BlockVoid would simply have an implicit
    //                   `#value_of(none)`.
    let &ASTData::Expr(actual_block) = &block.data else {
        unreachable("check_block: Node is not a block");
    };

    let value: &AST = null;
    let stmts: &GAF_List = null;
    match (&actual_block) {
        &ASTExpr::BlockVoid(_stmts) => {
            stmts = &_stmts;
        }
        &ASTExpr::BlockExpr(_stmts, _value) => {
            stmts = &_stmts;
            value = _value;
        }
        _ => {
            unreachable("check_block: Node is not a block");
        }
    }

    let fn = get_parent_function(block);
    let func_state = get_func_info(fn);

    push(&func_state.scopes, new_stack());

    for (let i: usize = 0; i < stmts.length; i = i + 1) {
        let stmt = get_ref(stmts, i) as &AST;

        let _ = check_stmt(&func_state.scopes, stmt);
        evaluate_comptime_variables(fn, null);
    }

    let type = create_base_type(PrimType::None);
    if (value != null) {
        let value_state = check_expr(&func_state.scopes, value);
        if (value_state.please_infer) return value_state;
        type = assert_is_valid(value_state, "check_block: Value type is invalid");
    }

    pop(&func_state.scopes);

    return mktcs(type);
}

@trace func check_stmt(scopes: &GAF_List, stmt: &AST) -> TCState {
    let &ASTData::Stmt(actual_stmt) = &stmt.data else {
        message(fatal(stmt.loc, "check_stmt: Node is not a statement"));
        unreachable();
    };
    if (stmt.type != null) return mktcs(stmt.type);

    let type: &Type = create_base_type(PrimType::None);
    let f = func (stmt: &AST, scopes: &GAF_List, pat: &AST, expr: &AST, trampoline: &AST) {
        if (expr != null) {
            let (needs_trampoline, _) = check_and_bind_pattern(scopes, pat, expr);
            if (trampoline != null) {
                // let <pat> = <expr> else <trampoline>;
                message(todo(stmt.loc, "check_stmt: Can't check pat-expr-trampoline yet"));
                if (!needs_trampoline) {
                    message(todo(stmt.loc, "check_stmt: pat-expr doesn't need trampoline"));
                } else {
                }
            } else if (needs_trampoline) {
                message(todo(stmt.loc, "check_stmt: pat-expr needs trampoline"));
            }
        } else {
            // let <pat>;
            assert(trampoline == null);
            message(todo(stmt.loc, "check_stmt: Can't check pat yet"));
        }
    };
    match (&actual_stmt) {
        &ASTStmt::Let { pat, expr, trampoline } => {
            f(stmt, scopes, pat, expr, trampoline);
            if (expr.type == null) {
                message(error(expr.loc, "Could not infer type of variable."));
            }
            if (expr.type.meta_level != 0) {
                message(error(expr.loc, "The type of a variable defined with `let` cannot be a meta-type, but got %.", to_string(expr.type)));
            }
        }
        &ASTStmt::Comptime { pat, expr, trampoline } => {
            f(stmt, scopes, pat, expr, trampoline);
            let fn = get_parent_function(stmt);
            let func_state = get_func_info(fn);
            codegen_stmt(func_state, stmt);
            evaluate_comptime_variables(fn, null);
            let noop = create_expr(stmt.parent, stmt.loc, stmt.origin, ASTExpr::Noop);
            actual_stmt = ASTStmt::Expr(noop);
        }
        &ASTStmt::ReturnVoid => {
            let fn = get_parent_function(stmt);
            let func_info = get_func_info(fn);
            let &BaseType::Func(_, ret_type) = &fn.type.base else {
                unreachable("check_stmt: Function has unexpected type");
            };
            assert(ret_type != null, "check_stmt: Function doesn't have return type set");
            if (!is_equal_to(ret_type, create_meta_type(1, PrimType::None))) {
                message(
                    error(stmt.loc, "Missing return value for function."),
                    note(fn.loc, "Function % is declared to return %.", func_info.name, to_string(ret_type)));
            }
            type = create_base_type(PrimType::None);
        }
        &ASTStmt::ReturnExpr(expr) => {
            let fn = get_parent_function(stmt);
            let &BaseType::Func(_, ret_type) = &fn.type.base else {
                unreachable("check_stmt: Function has unexpected type");
            };
            assert(ret_type != null, "check_stmt: Function doesn't have return type set");
            assert(ret_type.meta_level > 0, "check_stmt: Function doesn't have meta return type");
            let instance_of_ret_type = unwrap_meta_type(ret_type, 1);
            let expr_state = check_expr(scopes, expr);
            if (expr_state.please_infer) {
                expr_state = infer_type_onto_expr(scopes, instance_of_ret_type, expr);
                assert(!expr_state.please_infer, "check_stmt: Could not infer return type onto expression");
            }
            let etype: &Type = assert_is_valid(expr_state, "check_stmt: Return Expr type is invalid");
            if (!is_equal_to(etype, instance_of_ret_type)) {
                let t1 = to_string(instance_of_ret_type);
                let t2 = to_string(etype);
                if (is_convertible_to(etype, instance_of_ret_type)) {
                    message(todo(stmt.loc, "Function was declared to return %, but we got %. However, the type system could allow conversion.", t1, t2));
                } else {
                    message(error(stmt.loc, "Function was declared to return %, but we got %.", t1, t2));
                }
            }
        }
        &ASTStmt::Expr(expr) => {
            let is_assignment = is_assignment(expr);
            let expr_state = check_expr(scopes, expr);
            let none = create_base_type(PrimType::None);
            if (expr_state.please_infer) {
                expr_state = infer_type_onto_expr(scopes, none, expr);
                if (expr_state.please_infer) {
                    message(error(stmt.loc, "Couldn't infer type of expression."));
                }
            }
            let _type = assert_is_valid(expr_state, "check_stmt: Expr type is invalid");
            if (!is_equal_to(_type, none) && !is_assignment) {
                message(warn(stmt.loc, "Unused expression."));
            }
            type = _type;
        }
        &ASTStmt::Directive(dir) => {
            let _type = check_directive(scopes, stmt, dir);
            if (_type.replaced_node) return check_stmt(scopes, stmt);
            if (_type.please_infer) return _type;
            type = assert_is_valid(_type, "check_stmt: Directive type is invalid");
        }
        _ => {
            message(todo(stmt.loc, "check_stmt: Can't check stmt % yet", stmt));
        }
    }

    assert(type != null, "check_stmt: Type is null");

    stmt.type = type;
    return mktcs(type);
}

@trace func infer_type_onto_call(scopes: &GAF_List, ret_type: &Type, _expr: &AST) -> TCState {
    let &ASTData::Expr(ASTExpr::Call(_base, _args)) = &_expr.data else {
        unreachable("infer_type_onto_call: Node is not a call");
    };
    let args = new_GAF_List(type_info(&Type));
    for (let i: usize = 0; i < _args.length; i = i + 1) {
        let arg = get_ref(&_args, i) as &AST;
        let arg_state = check_expr(scopes, arg);
        let arg_type = arg_state.computed_type;
        if (arg_type == null) {
            arg_type = create_base_type(BaseType::Unknown);
        }
        push(&args, arg_type);
    }

    let fn = create_base_type(BaseType::Func(args, ret_type));
    let res_state = infer_type_onto_expr(scopes, fn, _base);
    if (res_state.please_infer) return res_state;
    let res = assert_is_valid(res_state, "infer_type_onto_call: Base type is invalid");
    let BaseType::Func(params, ret) = res.base else {
        unreachable("infer_type_onto_call: Inferred non-function onto call");
    };

    for (let i: usize = 0; i < _args.length; i = i + 1) {
        let arg = get_ref(&_args, i) as &AST;
        let _par = get_ref(&params, i) as &Type;
        let par = unwrap_meta_type(_par, 1);
        let arg_state = infer_type_onto_expr(scopes, par, arg);
        if (arg_state.please_infer) {
            message(todo(_expr.loc, "infer_type_onto_call: Can't infer call argument"));
        }
        let arg_type = assert_is_valid(arg_state, "infer_type_onto_call: Call argument type is invalid");
    }
    // REVIEW(2026-05-30): Should we expand here?
    if (expand_function_if_necessary(_expr, _base, &_args)) {
        // We just replaced a function call with a new block, we don't know anything about it.
        return mktcs(false, true, false, false, null);
    }

    ret = unwrap_meta_type(ret, 1);
    return mktcs(ret);
}

@trace func infer_type_onto_expr(scopes: &GAF_List, type: &Type, _expr: &AST) -> TCState {
    let expr_state = check_expr(scopes, _expr);
    if let (true, expr_type) = get_type_if_complete(expr_state) {
        if (!is_equal_to(type, expr_type)) {
            message(error(_expr.loc, "Could not infer type: Expected type %, but got %.", to_string(type), to_string(expr_type)));
        }
        return mktcs(expr_type);
    }
    let &ASTData::Expr(expr) = &_expr.data else {
        unreachable("infer_type_onto_expr: Node is not an expression");
    };
    let res_state = mktcs(type);
    match (&expr) {
        &ASTExpr::Ident { value } => {
            res_state = infer_type_onto_ident(scopes, type, _expr, value);
        }
        &ASTExpr::Number { value } => {
            if (!is_integer(type)) {
                message(error(_expr.loc, "Expected value of type %, but found a number literal.", to_string(type)));
            }
            let limits = [
                (PrimType::I8 , I8_MAX),
                (PrimType::I16, I16_MAX),
                (PrimType::I32, I32_MAX),
                (PrimType::I64, I64_MAX),
                (PrimType::U8 , U8_MAX),
                (PrimType::U16, U16_MAX),
                (PrimType::U32, U32_MAX),
                (PrimType::U64, U64_MAX),
            ];
            let number = toU64(&value);
            for (let i: usize = 0; i < limits.length; i = i + 1) {
                if let &BaseType::Prim(pt) = &type.base {
                    if (tag(&pt) == tag(&limits[i].0)) {
                        if (number >= limits[i].1) {
                            message(error(_expr.loc, "Number literal % is too big for target type %.", number, to_string(type)));
                        }
                    }
                }
            }
        }
        &ASTExpr::Blank => { },
        &ASTExpr::Call(_base, _args) => {
            res_state = infer_type_onto_call(scopes, type, _expr);
        }
        &ASTExpr::Dot(lhs, member) => {
            res_state = infer_type_onto_member(scopes, type, _expr, lhs, member);
        }
        &ASTExpr::VariantInit(lhs, variant_name, args) => {
            res_state = infer_type_onto_variant_init(scopes, type, _expr, lhs, variant_name, args);
        }
        _ => {
            message(todo(_expr.loc, "infer_type_onto_expr: Can't infer expression %", expr));
        }
    }

    if (res_state.please_infer) return res_state;

    _expr.type = assert_is_valid(res_state, "infer_type_onto_expr: Inferred type is invalid");
    return res_state;
}

@trace func infer_type_onto_member(scopes: &GAF_List, type: &Type, dot: &AST, lhs: &AST, member: &AST) -> TCState {
    assert(type != null, "infer_type_onto_member: Type is null");
    let lhs_type_state = check_expr(scopes, lhs);
    let lhs_type = assert_is_valid(lhs_type_state, "infer_type_onto_member");

    message(
        todo(dot.loc, "type: %", to_string(type)),
        note(dot.loc, "lhs: %", to_string(lhs_type))
    );
    return blank;
}

@trace func infer_type_onto_variant_init(scopes: &GAF_List, type: &Type, init: &AST, lhs: &AST, variant_name: SubStr, args: GAF_List) -> TCState {
    assert(type != null, "infer_type_onto_variant_init: Type is null");

    if (lhs != null) {
        // TODO(2026-07-17): Clean up this mess, ideally I want to be able to compile stuff like
        //                   let o: Option(i32) = Option.None;
        let lhs_type = lhs.type;
        assert(lhs_type != null, "infer_type_onto_variant_init: LHS does not have a type set");
        assert(lhs_type.meta_level != 0, "infer_type_onto_variant_init: LHS is not a meta type");
        lhs_type = unwrap_meta_type(lhs_type, 1);
        if (!is_equal_to(lhs_type, type)) {
            let t1 = to_string(type);
            let t2 = to_string(lhs_type);
            message(error(init.loc, "Expected expression of type %, but got %.", t1, t2));
        }
    }

    let &ASTData::Expr(ASTExpr::VariantInit(lhs1, _variant_name, _args)) = &init.data else {
        unreachable("infer_type_onto_variant_init");
    };
    if (lhs1 == null) {
        // REVIEW(2026-07-17): ResolvedGeneric doesn't really match here, but I dont feel like
        //                     adding another ASTExpr variant.
        lhs1 = create_expr(init, init.loc, init.origin, ASTExpr::ResolvedGeneric(type));
        lhs1.type = wrap_meta_type(type, 1);
    }
    let _st = check_variant_init(scopes, init, lhs1, variant_name, args);
    let _st_type = assert_is_valid(_st, "infer_type_onto_variant_init: check_variant_init failed to get a type");
    assert(is_equal_to(_st_type, type), "infer_type_onto_variant_init: check_variant_init got a different type");
    return _st;
}

@trace func check_and_bind_pattern(scopes: &GAF_List, _pat: &AST, _expr: &AST) -> (bool, bool) {
    let &ASTData::Pat(pat) = &_pat.data else {
        unreachable("check_and_bind_pattern: Node is not a pattern");
    };
    let &ASTData::Expr(expr) = &_expr.data else {
        unreachable("check_and_bind_pattern: Node is not an expression");
    };
    let result = (false, false);
    let type: &Type = null;
    match (&pat) {
        &ASTPat::Ident(name) => {
            let type_state = check_expr(scopes, _expr);
            if (!type_state.is_complete) {
                message(
                    error(_expr.loc, "Could not infer type of variable %.", name),
                    help(_expr.loc, "Please add a type annotation."),
                );
            }
            type = assert_is_valid(type_state, "check_and_bind_pattern: Ident type is invalid");

            let _last = get_ref_raw(scopes, scopes.length - 1) as &Scope_Info;
            if (contains(&_last.variables, _pat.origin)) {
                message(todo(_pat.loc, "check_and_bind_pattern: Redefinition of identifier"));
            } else {
                add(&_last.variables, _pat.origin, Variable {
                    origin: _pat,
                    type: type
                });
            }
            result = (false, false);
        },
        &ASTPat::PatWithType(subpat, subtype) => {
            let type_state = check_expr(scopes, subtype);
            if (type_state.please_infer) message(todo(_expr.loc, "check_and_bind_pattern: Type wants infer"));
            type = assert_is_valid(type_state, "check_and_bind_pattern: PatWithType type is invalid");
            type = unwrap_meta_type(type, 1);
            type_state = infer_type_onto_expr(scopes, type, _expr);
            assert(type_state.is_complete && _expr.type != null, "check_and_bind_pattern: PatWithType: Inference failed");

            result = check_and_bind_pattern(scopes, subpat, _expr);
            assert(subpat.type != null, "check_and_bind_pattern: PatWithType: Subpattern has no type");
            assert(is_equal_to(type, subpat.type), "check_and_bind_pattern: PatWithType: Type doesn't match");
        }
        _ => {
            message(todo(_pat.loc, "check_and_bind_pattern: Can't check pattern yet"));
        }
    }
    _pat.type = type;
    return result;
}

@trace func infer_type_onto_ident(scopes: &GAF_List, infer_type: &Type, ast: &AST, ident: SubStr) -> TCState {
    let replaced_node = false;
    let type: &Type = null;
    if let (var, true) = get_variable_by_name(scopes, ident) {
        if (var.type == null) {
            message(
                todo(ast.loc, "Found ident, but type of variable is unknown"),
                dbg(var.origin.loc, "variable declared here"));
        }
        type = var.type;
    } else {
        if let (sl, fl) = get_global_identifier(ident) {
            if (sl != null && fl != null) {
                message(todo(ast.loc, "infer_type_onto_ident: global ident can be both"));
            } else if (sl != null) {
                let type = create_meta_type(1, BaseType::TypeDecl(sl.node));
                let info = get_type_decl_info(sl.node);
                let isg = is_generic(info);
                return mktcs(!isg, false, isg, false, type);
            } else if (fl != null) {
                assert(fl.overloads.length != 0, "infer_type_onto_ident: function overloads are empty??");

                if (infer_type == null) return mktcs(false, false, false, true, null);
                let &BaseType::Func(args, ret) = &infer_type.base else {
                    message(error(ast.loc, "Expected value of type %, but found a function named %.", to_string(infer_type), ident));
                    unreachable(); // error terminates
                };

                let candidates = new_GAF_List(type_info(&AST));
                for (let _ga: usize = 0; _ga < 2; _ga = _ga + 1) {
                    let generics_allowed = _ga != 0;
                    if (candidates.length > 0) {
                        // NOTE(2026-05-31): For now we'll choose specializations over generic
                        //                   functions. That means if there's a `func foo(a: $T)`
                        //                   and a `func foo(a: i32)`, we will always choose
                        //                   `foo(i32)`.
                        break;
                    }
                    for (let i: usize = 0; i < fl.overloads.length; i = i + 1) {
                        let _fn = get_ref(&fl.overloads, i) as &AST;
                        let func_state = get_func_info(_fn);
                        if (func_state.params.length != args.length) {
                            continue;
                        }

                        if (is_generic(func_state)) {
                            if (generics_allowed) {
                                let (mapping, success, unknown) = collect_generic_type_mapping(_fn, infer_type);
                                if (!success) continue;
                                _fn = monomorphize_function_node(_fn, mapping);
                            } else {
                                continue;
                            }
                        }

                        let (resp, state) = wait_for_monitor(&_fn.type);
                        match (state) {
                            Corot_Result::Cycle_Detected => {
                                message(
                                    error(ast.loc, "Could not resolve type of function due to a cyclic dependency on %.", corot_str(resp)),
                                    note(_fn.loc, "Function % declared here.", func_state.name),
                                );
                            }
                            Corot_Result::Fucking_Died => {
                                message(
                                    error(ast.loc, "Could not resolve type of function. There were errors."),
                                    note(_fn.loc, "Function % declared here.", func_state.name),
                                );
                            }
                            _ => { }
                        }
                        assert(tag(&state) == comptime tag(&Corot_Result::Success), "We just checked the state");
                        assert(_fn.type != null, "infer_type_onto_ident: monitor failed");

                        if (call_type_matches_function_type(infer_type, _fn.type)) {
                            let duplicate = false;
                            for (let i: usize = 0; i < candidates.length; i = i + 1) {
                                let cand = get_ref(&candidates, i) as &AST;
                                if (cand == _fn) {
                                    duplicate = true;
                                    break;
                                }
                            }
                            if (!duplicate) push(&candidates, _fn);
                        }
                    }
                }
                if (candidates.length == 0) {
                    if (is_unknown(ret)) {
                        return mktcs(false, false, false, true, null);
                    }
                    suppress_exit_on_error();
                    message(
                        error(ast.loc, "Could not find overload for call to function %.", ident),
                        note(ast.loc, "No candidate matches the signature %.", to_string(infer_type)),
                    );
                    if (fl.overloads.length == 1) {
                        message(note(ast.loc, "There is % candidate that could match:", fl.overloads.length));
                    } else {
                        message(note(ast.loc, "There are % candidates that could match:", fl.overloads.length));
                    }
                    for (let i: usize = 0; i < fl.overloads.length; i = i + 1) {
                        let _fn = get_ref(&fl.overloads, i) as &AST;
                        let func_state = get_func_info(_fn);
                        if (is_generic(func_state)) {
                            message(note(_fn.loc, "This generic function."));
                        } else {
                            message(note(_fn.loc, "This function with signature %.", to_string(_fn.type)));
                        }
                    }
                    message(finalize_error());
                    unreachable();
                } else if (candidates.length > 1) {
                    suppress_exit_on_error();
                    message(
                        error(ast.loc, "Found more than one possible overload for call to function %.", ident),
                        note(ast.loc, "There are % possible overloads.", candidates.length),
                    );
                    for (let i: usize = 0; i < candidates.length; i = i + 1) {
                        let candidate = get_ref(&candidates, i) as &AST;
                        if (i == 0) {
                            message(note(candidate.loc, "We could call this function."));
                        } else {
                            message(note(candidate.loc, "...or this one."));
                        }
                    }
                    message(finalize_error());
                }
                let candidate = get_ref(&candidates, 0) as &AST;

                let func_state = get_func_info(candidate);
                assert(!is_generic(func_state), "Candidate is still generic");
                assert(candidate.type != null, "Candidate still has no type");

                if let &ASTData::Expr(expr) = &ast.data {
                    ast.data = ASTData::Expr(ASTExpr::FnIdent { name: ident, fn: candidate });
                    replaced_node = true;
                }
                free(&candidates);
                type = candidate.type;
            } else {
                message(error(ast.loc, "Use of undeclared identifier `%`.", ident));
            }
        } else {
            message(todo(ast.loc, "infer_type_onto_ident: no such ident"));
        }
    }

    assert(type != null, "infer_type_onto_ident: Type is null");
    return mktcs(true, replaced_node, false, false, type);
}

@trace func convert_to_comptime_value_if_possible(scopes: &GAF_List, expr: &AST) -> (Value, bool) {
    let &ASTData::Expr(sub) = &expr.data else {
        return (Value::Invalid, false);
    };
    match (sub) {
        ASTExpr::ComptimeValue(ct_value) => { return (ct_value, true); }
        ASTExpr::StringLiteral { .. } => { }
        _ => { return (Value::Invalid, false); }
    }

    let new = create_directive(expr.parent, expr.loc, expr.origin, Directive::Run(expr));
    let _ = check_directive(scopes, expr, new);
    let &ASTData::Expr(ASTExpr::ComptimeValue(ct_value)) = &expr.data else {
        unreachable("#run failed to convert expr to ComptimeValue");
    };
    return (ct_value, true);
}

@trace func check_directive(scopes: &GAF_List, parent: &AST, dir: &AST) -> TCState {
    let &ASTData::Directive(directive) = &dir.data else {
        unreachable("check_directive: Node is not a directive");
    };
    match (directive) {
        Directive::Run(run_expr) => {
            let _type_state = check_expr(scopes, run_expr);
            // We don't know what `#run <expr>` should return. Must infer.
            if (_type_state.please_infer) return _type_state;
            let _type = assert_is_valid(_type_state, "check_directive: #run expr type is invalid");

            // We do know its type. We can now execute the expression and
            // replace the AST node with a new value.
            let fn = get_parent_function(run_expr);
            let func_state = get_func_info(fn);

            let _tmp1 = format1("_run_%", run_expr);
            let _tmp = asSubStr(&_tmp1);

            let result = ASTExpr::Noop;
            if (!is_none(run_expr.type)) {
                start_comptime(&func_state.code);
                let var_reg = build_alloca(&func_state.code, run_expr.loc, run_expr.type, _tmp);
                let creg = codegen_expr(func_state, run_expr, false);
                build_store(&func_state.code, run_expr.loc, var_reg, creg);
                end_comptime(&func_state.code);

                evaluate_comptime_variables(fn, &_tmp);

                let ct = &func_state.code.komptime;
                reset(ct);

                let (var, true) = get_comptime_variable(&func_state.code, _tmp) else {
                    unreachable();
                };
                result = ASTExpr::ComptimeValue(var);
            } else {
                start_comptime(&func_state.code);
                let creg = codegen_expr(func_state, run_expr, false);
                end_comptime(&func_state.code);

                evaluate_comptime_variables(fn, &_tmp);

                let ct = &func_state.code.komptime;
                reset(ct);
            }

            if let ASTData::Stmt(_) = parent.data {
                let _expr = create_expr(parent, dir.loc, parent.origin, result);
                _expr.type = _type;
                parent.data = ASTData::Stmt(ASTStmt::Expr(_expr));
            } else {
                parent.data = ASTData::Expr(result);
            }
            parent.type = _type;
            return mktcs(true, true, false, false, _type);
        }
        Directive::Insert(insert_expr, insert_context) => {
            let _type_state = check_expr(scopes, insert_expr);
            let str = create_base_type(PrimType::Str);
            if (_type_state.please_infer) {
                _type_state = infer_type_onto_expr(scopes, str, insert_expr);
            }
            let _type = assert_is_valid(_type_state, "check_directive: #insert expr type is invalid");
            if (!is_equal_to(_type, str)) {
                message(error(dir.loc, "#insert sub-expression must be a value of type %, but got %.", to_string(str), to_string(_type)));
            }

            let (ct_value, true) = convert_to_comptime_value_if_possible(scopes, insert_expr) else {
                message(error(dir.loc, "#insert sub-expression must be a comptime value. Did you forget a #run?"));
                unreachable(); // error terminates
            };
            let Value::Var { ptr, size } = ct_value else {
                funreachable("Directive::Insert: Expected Value::Var, got %", ct_value);
            };
            assert(size == 16, "Directive::Insert: Expected value to be 16 bytes");

            let source = *(ptr as &SubStr);
            let lexer = Lexer {
                file_name: dir.loc.file,
                offset_in_file: dir.loc.offset,
                source: source,
            };
            let parse_context = Parse_Context {
                parent: insert_context.parent,
                lexer: lexer,
                generic_type_mapping: insert_context.generic_type_mapping,
            };

            let (gen, res) = insert_context.parse_fn(&parse_context);
            assert(res != null, "#insert failed to insert new node");
            assert(!gen, "#insert-ed blob should never be generic. The mapping has already happened");

            if (insert_context.parse_fn as Any == parse_stmt as Any) {
                let ASTData::Stmt(_) = res.data else {
                    message(error(dir.loc, "Expected a statement in this #insert context, but got an expression instead."));
                    unreachable(); // error terminates
                };
                let res_state = check_stmt(scopes, res);
                res.type = assert_is_valid(res_state, "check_directive: #insert-ed stmt type is invalid");
            } else if (insert_context.parse_fn as Any == parse_expr as Any) {
                let ASTData::Expr(_) = res.data else {
                    message(error(dir.loc, "Expected an expression in this #insert context, but got a statement instead."));
                    unreachable(); // error terminates
                };
                let res_state = check_expr(scopes, res);
                res.type = assert_is_valid(res_state, "check_directive: #insert-ed expr type is invalid");
            }

            *parent = *res;
            return mktcs(true, true, false, false, res.type);
        }
        Directive::Assert(assert_expr, _msg) => {
            let _type_state = check_expr(scopes, assert_expr);
            let b = create_base_type(PrimType::Bool);
            if (_type_state.please_infer) {
                _type_state = infer_type_onto_expr(scopes, b, assert_expr);
            }
            let _type = assert_is_valid(_type_state, "check_directive: #assert expr type is invalid");
            if (!is_equal_to(_type, b)) {
                message(error(dir.loc, "#assert sub-expression must be a value of type %, but got %.", to_string(b), to_string(_type)));
            }
            let t = create_base_type(PrimType::None);
            return mktcs(t);
        }
        Directive::Bir(lexer) => {
            let checked_lexer = lexer;
            let fn_node = get_parent_function(dir);
            assert(fn_node != null, "codegen_stmt: Directive parent is null");
            let start = expect(&lexer, TokenData::CurlyOpen);
            let register_map = new_hashmap_with_substr_key(type_info(Reg));
            let type_list = new_GAF_List(type_info(&Type));
            let type: &Type = null;
            while (!lexer_at(&lexer, TokenData::CurlyClose)) {
                type = parse_bufo_ir_into_function_body(fn_node, &register_map, &lexer, null, false);
                push(&type_list, type);
            }
            directive = Directive::CheckedBir(checked_lexer, type_list);
            return mktcs(type);
        }
        Directive::Debug => {
            let t = create_base_type(PrimType::None);
            return mktcs(t);
        }
        _ => {
            message(todo(dir.loc, "check_directive: Exhaustive handling of Directives"));
        }
    }
    unreachable("check_directive");
}

@trace func __expand_helper(loc: Loc, parent: &AST, node: &AST, mapping: &GAF_HashMap, scopes: &GAF_List) -> &AST {
    match (node.data) {
        // Statements
        ASTData::Stmt(ASTStmt::Let { pat, expr, trampoline }) => {
            let new_pat = __expand_helper(loc, node, pat, mapping, scopes);
            let new_expr: &AST = null;
            if (expr != null) new_expr = __expand_helper(loc, node, expr, mapping, scopes);
            let new_trampoline: &AST = null;
            if (trampoline != null) new_trampoline = __expand_helper(loc, node, trampoline, mapping, scopes);
            return create_stmt(parent, loc, node.origin, ASTStmt::Let { pat: pat, expr: expr, trampoline: trampoline });
        }
        ASTData::Stmt(ASTStmt::Expr(expr)) => {
            let new_expr = __expand_helper(loc, node, expr, mapping, scopes);
            return create_stmt(parent, loc, node.origin, ASTStmt::Expr(new_expr));
        }
        // Expressions
        ASTData::Expr(ASTExpr::BlockVoid(stmts)) => {
            let block = new_GAF_List(type_info(&AST));
            let bl = create_expr(parent, loc, node.origin, ASTExpr::BlockVoid);
            push(scopes, new_stack());
            for (let i: usize = 0; i < stmts.length; i = i + 1) {
                let s = get_ref(&stmts, i) as &AST;
                let new_stmt = __expand_helper(loc, bl, s, mapping, scopes);
                push(&block, new_stmt);
            }
            pop(scopes);
            bl.data = ASTData::Expr(ASTExpr::BlockVoid(block));
            return bl;
        }
        ASTData::Expr(ASTExpr::Call(base, args)) => {
            let new_args = new_GAF_List(type_info(&AST));
            let new_call = create_expr(parent, loc, node.origin, ASTExpr::Call);
            let new_base = __expand_helper(loc, new_call, base, mapping, scopes);
            for (let i: usize = 0; i < args.length; i = i + 1) {
                let a = get_ref(&args, i) as &AST;
                let new = __expand_helper(loc, new_call, a, mapping, scopes);
                push(&new_args, new);
            }
            new_call.data = ASTData::Expr(ASTExpr::Call(new_base, new_args));
            return new_call;
        }
        ASTData::Expr(ASTExpr::Number { value }) => {
            return create_expr(parent, loc, node.origin, ASTExpr::Number { value: value });
        }
        ASTData::Expr(ASTExpr::StringLiteral { value }) => {
            return create_expr(parent, loc, node.origin, ASTExpr::StringLiteral { value: value });
        }
        ASTData::Expr(ASTExpr::BuiltinType { name }) => {
            return create_expr(parent, loc, node.origin, ASTExpr::BuiltinType { name: name });
        }
        ASTData::Expr(ASTExpr::FnIdent { name, fn }) => {
            return create_expr(parent, loc, node.origin, ASTExpr::FnIdent { name: name, fn: fn });
        }
        ASTData::Expr(ASTExpr::Ident { name }) => {
            let last = get_ref_raw(scopes, scopes.length - 1) as &Scope_Info;
            if (contains(&last.variables, name)) {
                return create_expr(parent, loc, node.origin, ASTExpr::Ident { name: name });
            } else {
                let maybe_new = get(mapping, name);
                if (maybe_new.ptr != null) {
                    // Replace the old identifier in a function with its expanded argument.
                    let new_name = maybe_new as String;
                    return create_expr(parent, loc, node.origin, ASTExpr::Ident { name: asSubStr(&new_name) });
                } else {
                    return create_expr(parent, loc, node.origin, ASTExpr::Ident { name: name });
                }
            }
        }
        // Patterns
        ASTData::Pat(ASTPat::PatWithType(pat, type)) => {
            let new_pat = __expand_helper(loc, node, pat, mapping, scopes);
            let new_type = __expand_helper(loc, node, type, mapping, scopes);
            return create_pattern(parent, loc, node.origin, ASTPat::PatWithType(new_pat, new_type));
        }
        ASTData::Pat(ASTPat::Ident(name)) => {
            if (contains(mapping, name)) {
                message(warn(node.loc, "Variable % shadows parameter name for function that is getting #expand-ed.", name));
            }
            let last = get_ref_raw(scopes, scopes.length - 1) as &Scope_Info;
            add(&last.variables, name, Variable { origin: node, type: node.type });
            return create_pattern(parent, loc, node.origin, ASTPat::Ident(name));
        }
        data => {
            message(todo(node.loc, "__expand_helper: %", data));
        }
    }
    unreachable("__expand_helper");
}

@trace func expand_function_if_necessary(expr: &AST, base: &AST, args: &GAF_List) -> bool {
    let &ASTData::Expr(ASTExpr::FnIdent { name, fn }) = &base.data else {
        return false; // Not a function
    };
    if (!has_attribute(fn, ASTAttrData::Expand)) return false;
    let func_info = get_func_info(fn);
    assert(func_info.params.length == args.length, "expand_function_if_necessary: length mismatch");

    let (resp, state) = wait_for_monitor(&func_info.block);
    let Corot_Result::Success = state else {
        suppress_exit_on_error();
        match (state) {
            Corot_Result::Cycle_Detected => {
                message(
                    error(expr.loc, "Could not expand call to function % due to a cyclic dependency on %.", func_info.name, corot_str(resp)),
                    note(fn.loc, "Function % declared here.", func_info.name),
                    help(fn.loc, "Did you call %() in another function marked `@expand`?", func_info.name),
                );
            }
            Corot_Result::Fucking_Died => {
                message(
                    error(expr.loc, "Could not expand call to function %. There were errors.", func_info.name),
                    note(fn.loc, "Function % declared here.", func_info.name),
                );
            }
            _ => { }
        }
        _finish_current(state);
    };
    assert(func_info.block != null, "expand_function_if_necessary: monitor failed");

    let new_block = new_GAF_List(type_info(&AST));
    let new_block_ast = create_expr(expr.parent, expr.loc, expr.origin, ASTExpr::BlockExpr); // dummy node

    let mapping = new_hashmap_with_substr_key(type_info(String));
    for (let i: usize = 0; i < args.length; i = i + 1) {
        let arg = get_ref(args, i) as &AST;
        let par = get_ref(&func_info.params, i) as &AST;
        let par_name = par.origin;

        // Create a temporary variable and assign the argument to it.
        let new_name = format1(".expanded.%.%", par_name, arg);
        let _n = asSubStr(&new_name);
        let pat_id = create_pattern(new_block_ast, expr.loc, blank, ASTPat::Ident(_n));
        let assign = create_stmt(new_block_ast, expr.loc, blank, ASTStmt::Let {
            pat: pat_id,
            expr: arg,
            trampoline: null
        });

        add(&mapping, par_name, new_name);
        push(&new_block, assign);
    }

    let cid = spawn(func (arg: Any) {
        let &(call, fn, func_info, mapping, new_block) = arg as &(&AST, &AST, &ASTFunction, &GAF_HashMap, GAF_List);
        // NOTE(2026-04-13): As of today expansions form their own block. Any variables that are
        //                   defined in the function body can't escape to the call site.
        //                   Similarly, any variable you want to pass from the call site to the
        //                   body must be passed as an argument.

        assert(fn.type != null, "Expected function type to be ready at this point");

        // Apply the expansion.
        let scopes = new_GAF_List(type_info(Scope_Info));
        let _block = __expand_helper(call.loc, call.parent, func_info.block, mapping, &scopes);
        let block = create_stmt(call.parent, call.loc, blank, ASTStmt::Expr(_block));
        push(&new_block, block);

        // Update the call site.
        call.data = ASTData::Expr(ASTExpr::BlockVoid(new_block));
        call.type = null;
        let _ = check_block(call);
    }, &(expr, fn, func_info, &mapping, new_block));

    handle_corot_result(wait(cid),
        error(expr.loc, "Could not expand function due to a cyclic dependency on %.", corot_str(cid)),
        note(expr.loc, "...while expanding this function call."));

    return true;
}

struct TCState {
    is_complete: bool;
    replaced_node: bool;
    needs_monomorphization: bool;
    please_infer: bool;
    computed_type: &Type;
}

@trace func get_type_if_complete(t: TCState) -> (bool, &Type) {
    return (t.is_complete, t.computed_type);
}

@trace func assert_is_valid(t: TCState, msg: &char) -> &Type {
    assert(t.is_complete || t.needs_monomorphization, msg);
    assert(t.computed_type != null, msg);
    return t.computed_type;
}

@trace func mktcs(type: &Type) -> TCState {
    return mktcs(true, false, false, false, type);
}
@trace func mktcs(is_complete: bool, replaced_node: bool, needs_monomorphization: bool, please_infer: bool, type: &Type) -> TCState {
    return TCState {
        is_complete: is_complete,
        replaced_node: replaced_node,
        needs_monomorphization: needs_monomorphization,
        please_infer: please_infer,
        computed_type: type,
    };
}

@trace func check_expr(scopes: &GAF_List, _expr: &AST) -> TCState {
    if (_expr.type != null) return mktcs(_expr.type);

    let &ASTData::Expr(expr) = &_expr.data else {
        message(fatal(_expr.loc, "check_expr: Node is not an expression: %", _expr.data));
        unreachable();
    };
    let type_state: TCState = blank;
    match (&expr) {
        &ASTExpr::ResolvedGeneric(gen) => {
            type_state = mktcs(gen);
        }
        &ASTExpr::BuiltinType { name } => {
            type_state = mktcs(get_builtin_type(name));
        }
        &ASTExpr::FnIdent { name, fn } => {
            assert(fn.type != null, "FnIdent function type is null");
            type_state = mktcs(fn.type);
        }
        &ASTExpr::Ident { name } => {
            type_state = infer_type_onto_ident(scopes, null, _expr, name);
            if (is_in_function(_expr)) {
                // If this identifier refers to a compile time variable, insert the value here.
                let fn = get_parent_function(_expr);
                let func_state = get_func_info(fn);
                if let (var, true) = get_comptime_variable(&func_state.code, name) {
                    _expr.data = ASTData::Expr(ASTExpr::ComptimeValue(var));
                }
            }
        }
        &ASTExpr::Number { value } => {
            type_state = mktcs(false, false, false, true, null); // Number Literals must be inferred from context
        }
        &ASTExpr::StringLiteral { value } => {
            type_state = mktcs(create_base_type(PrimType::Str));
        }
        &ASTExpr::If(cond, then) => {
            let cond_state = check_expr(scopes, cond);
            let b = create_base_type(PrimType::Bool);
            if (cond_state.please_infer) {
                cond_state = infer_type_onto_expr(scopes, b, cond);
            }
            let cond_type = assert_is_valid(cond_state, "check_expr: If Cond type is invalid");
            if (!is_convertible_to(cond_type, b)) {
                let t1 = to_string(b);
                let t2 = to_string(cond_type);
                message(error(cond.loc, "Expected expression of type %, but got %.", t1, t2));
            }
            let then_state = check_stmt(scopes, then);
            if (then_state.please_infer) {
                message(todo(then.loc, "then needs infer?"));
            }
            assert_is_valid(then_state, "check_expr: If Then type is invalid");
            type_state = mktcs(create_base_type(PrimType::None));
        }
        &ASTExpr::Dot(lhs, member) => {
            type_state = check_member_expr(scopes, _expr, lhs, member);
        }
        &ASTExpr::VariantInit(lhs, variant, args) => {
            type_state = check_variant_init(scopes, _expr, lhs, variant, args);
        }
        &ASTExpr::Call(_base, _args) => {
            let base_state = check_expr(scopes, _base);
            if (base_state.replaced_node) {
                // We may have replaced ourselves if we are a variant initialization, for example.
                return check_expr(scopes, _expr);
            }
            if (base_state.please_infer) {
                // base may be null because of function overloading,
                // however we already have some information at this point:
                // The arguments of the call. We may not know all of them,
                // and we don't even know what we expect, but we can still try
                // to get a candidate here.
                let ret_type = create_base_type(BaseType::Unknown);
                base_state = infer_type_onto_call(scopes, ret_type, _expr);
                // Still nothing, we have to retry later.
                if (base_state.please_infer) return base_state;
                assert(_base.type != null, "check_expr: Base type is null");
                base_state = mktcs(_base.type);
            }
            let base = assert_is_valid(base_state, "check_expr: Call base type is invalid");
            match (&base.base) {
                &BaseType::Func(params, ret) => {
                    if (_args.length != params.length) {
                        message(todo(_expr.loc, "check_expr: Argument count mismatch"));
                    }
                    for (let i: usize = 0; i < params.length; i = i + 1) {
                        let arg = get_ref(&_args, i) as &AST;
                        let _par = get_ref(&params, i) as &Type;
                        let par = unwrap_meta_type(_par, 1);
                        let arg_state = check_expr(scopes, arg);
                        if (arg_state.please_infer) {
                            arg_state = infer_type_onto_expr(scopes, par, arg);
                        }
                        let atype = assert_is_valid(arg_state, "check_expr: Arg type is invalid");
                        if (!is_equal_to(atype, par)) {
                            if (is_convertible_to(atype, par)) {
                                message(todo(arg.loc, "Parameter was declared to be %, but we got %. However, the type system could allow conversion.", par, atype));
                            }
                            message(error(arg.loc, "Expected type %, but got %.", to_string(par), to_string(atype)));
                        }
                    }
                    type_state = mktcs(unwrap_meta_type(ret, 1));
                }
                &BaseType::TypeDecl(node) => {
                    assert(node != null, "TypeDecl node is null");
                    let info = get_type_decl_info(node);
                    assert(is_generic(info), "TypeDecl node is not generic?");

                    if (base.meta_level == 0) {
                        message(
                            error(_base.loc, "Cannot call expression of type %.", info.name),
                            note(node.loc, "Type % declared here.", info.name),
                        );
                    }
                    if (!base_state.needs_monomorphization) {
                        message(
                            error(_base.loc, "Unexpected generic parameters for non-generic type %.", info.name),
                            note(node.loc, "Type % declared here.", info.name),
                        );
                    }
                    if (_args.length != info.parameters.length) {
                        message(todo(_base.loc, "Generic instantiation didn't get enough / got too many arguments"));
                    }

                    let mapping = new_generic_type_mapping();
                    for (let i: usize = 0; i < _args.length; i = i + 1) {
                        let node = get_ref(&info.parameters, i) as &AST;
                        let arg = get_ref(&_args, i) as &AST;
                        let arg_state = check_expr(scopes, arg);
                        if (arg_state.please_infer) {
                            message(todo(arg.loc, "Generic parameter wants infer???"));
                        }
                        let type = assert_is_valid(arg_state, "Generic Type argument type is invalid");
                        if (type.meta_level == 0) {
                            message(todo(arg.loc, "check_type_decl_type: Generic parameter is not a meta-type"));
                        }
                        add(&mapping, node.origin, type);
                    }

                    let new_node = monomorphize_type_decl_node(node, mapping);
                    let new_type = create_meta_type(base.meta_level, BaseType::TypeDecl(new_node));
                    type_state = mktcs(new_type);
                }
                _ => { message(todo(_expr.loc, "check_expr: Call with base type %", *base)); }
            }
            expand_function_if_necessary(_expr, _base, &_args);
        }
        &ASTExpr::Unary(_) => {
            type_state = check_unary_expr(scopes, _expr);
        }
        &ASTExpr::Binary(_) => {
            type_state = check_binary_expr(scopes, _expr);
        }
        // Types of blank and null must be inferred elsewhere
        &ASTExpr::Blank => { type_state = mktcs(false, false, false, true, null); }
        &ASTExpr::Null  => { type_state = mktcs(false, false, false, true, null); }
        &ASTExpr::Directive(dir) => {
            let _type = check_directive(scopes, _expr, dir);
            if (_type.replaced_node) type_state = check_expr(scopes, _expr);
            else type_state = _type;
        }
        &ASTExpr::BlockVoid(stmts) => {
            type_state = check_block(_expr);
        }
        &ASTExpr::BlockExpr(stmts, value) => {
            type_state = check_block(_expr);
        }
        &ASTExpr::Noop => {
            type_state = mktcs(create_base_type(PrimType::None));
        }
        _ => {
            message(todo(_expr.loc, "check_expr: Can't check expression %", expr));
        }
    }
    if (type_state.replaced_node) return type_state;
    if (type_state.please_infer) return type_state;
    _expr.type = assert_is_valid(type_state, "check_expr: Expr type is invalid");
    return type_state;
}

@trace func check_variant_init(scopes: &GAF_List, init: &AST, lhs: &AST, variant_name: SubStr, args: GAF_List) -> TCState {
    let lhs_type: &Type = null;
    if (lhs != null) {
        lhs_type = lhs.type;
        assert(lhs_type != null, "check_variant_init: Expected a set type for lhs");
    }
    if (lhs_type == null) return mktcs(false, false, false, true, null);
    assert(lhs_type.meta_level != 0, "check_variant_init: Expected meta type");

    let BaseType::TypeDecl(decl_node) = lhs_type.base else {
        message(todo(init.loc, "check_variant_init: LHS type is not a type decl?"));
        unreachable(); // todo terminates
    };
    let decl_info = get_type_decl_info(decl_node);

    if (is_generic(decl_info)) {
        let ty_str = to_string(lhs_type);
        message(
            error(init.loc, "Cannot initialize variant % of generic type %.", variant_name, ty_str),
            note(init.loc, "Due to extensive metaprogramming capabilities, a monomorphized instance of this type may not have this variant."),
            note(init.loc, "For example, the variant may be hidden behind an `#if`, so we don't try to guess a mapping for the generic parameters."),
            help(init.loc, "Please specify the generic parameters manually.")
        );
    }

    // REVIEW(2026-07-14): I think this should be a wait_for_monitor
    assert(decl_info.state.did_check_variants, "check_variant_init: Variants havent been type checked yet");

    let (true, variant) = get_variant_by_name(decl_info, variant_name) else {
        message(
            error(init.loc, "The type % doesn't have a variant named `%`.", decl_info.name, variant_name),
            note(decl_info.loc, "Type % is declared here.", decl_info.name));
        unreachable(); // error terminates
    };

    if (variant.fields.length > 0) {
        let ty_str = to_string(lhs_type);
        let maybe_s = "";
        if (variant.fields.length != 1) maybe_s = "s";
        if (args.length == 0) {
            message(warn(init.loc, "Missing % argument% for initialization of variant % of type %.", variant.fields.length, maybe_s, variant_name, ty_str));
        } else if (args.length != variant.fields.length) {
            let pre = "Not enough";
            if (args.length > variant.fields.length) pre = "Too many";
            message(
                error(init.loc, "% arguments were provided for initialization of variant % of type %.", pre, variant_name, ty_str),
                note(init.loc, "Expected % argument%, but got %.", variant.fields.length, maybe_s, args.length),
            );
        }
        for (let i: usize = 0; i < args.length; i = i + 1) {
            let _field = get_ref(&variant.fields, i) as &AST;
            let _field_type = _field.type;
            assert(_field_type != null, "check_variant_init: Variant field is not initialized");
            assert(_field_type.meta_level != 0, "check_variant_init: Variant field is not a meta type");
            let field_type = unwrap_meta_type(_field_type, 1);

            let _arg = get_ref(&args, i) as &AST;
            let arg_state = check_expr(scopes, _arg);
            if (arg_state.please_infer) {
                arg_state = infer_type_onto_expr(scopes, field_type, _arg);
            }
            let arg_type = assert_is_valid(arg_state, "check_variant_init: Argument type is invalid");

            if (!is_equal_to(arg_type, field_type)) {
                message(error(_arg.loc, "Expected type %, but got %.", to_string(field_type), to_string(arg_type)));
            }
        }
    }
    lhs_type = unwrap_meta_type(lhs_type, 1);
    init.type = lhs_type;
    return mktcs(lhs_type);
}

@trace func check_member_expr(scopes: &GAF_List, dot: &AST, lhs: &AST, member: &AST) -> TCState {
    let lhs_type_state = check_expr(scopes, lhs);
    if (lhs_type_state.please_infer) return lhs_type_state;
    let lhs_type = assert_is_valid(lhs_type_state, "check_member_expr: LHS type is invalid");

    if (is_pointer(lhs_type)) lhs_type = get_underlying_type(lhs_type);

    if let BaseType::TypeDecl(type_decl_node) = lhs_type.base {
        let &ASTData::Expr(ASTExpr::Ident { field_or_method }) = &member.data else {
            message(error(member.loc, "The Dot operator only supports member fields for structs."));
            unreachable(); // error terminates
        };
        let type_decl_info = get_type_decl_info(type_decl_node);

        if (lhs_type.meta_level == 0) {
            assert(!is_generic(type_decl_info), "check_member_expr: Member access on generic LHS type?");
            assert(type_decl_info.state.did_check_fields, "check_member_expr: Node of LHS type is not type checked?");
            let (true, field) = get_field_by_name(type_decl_info, field_or_method) else {
                message(
                    error(member.loc, "The type % doesn't have a field named `%`.", type_decl_info.name, field_or_method),
                    note(type_decl_info.loc, "Type % is declared here.", type_decl_info.name));
                unreachable(); // error terminates
            };
            assert(field.type_node.type != null, "check_member_expr: Field type is not ready");
            assert(field.type_node.type.meta_level > 0, "check_member_expr: Field type is not a meta type");
            return mktcs(unwrap_meta_type(field.type_node.type, 1));
        } else {
            let parent = dot.parent;
            if let ASTData::Expr(ASTExpr::Call(_lhs, args)) = parent.data {
                assert(_lhs == dot, "Dot parent is a call, but the call base is not the dot");
                parent.data = ASTData::Expr(ASTExpr::VariantInit(lhs, field_or_method, args));
            } else {
                dot.data = ASTData::Expr(ASTExpr::VariantInit(lhs, field_or_method, blank));
            }
            return mktcs(false, true, false, false, null);
        }
    } else {
        message(error(dot.loc, "The Dot operator is currently only supported for struct types."));
    }
    unreachable();
}

@trace func check_unary_expr(scopes: &GAF_List, expr: &AST) -> TCState {
    let &ASTData::Expr(ASTExpr::Unary(unary)) = &expr.data else {
        unreachable("check_unary_expr: Node is not a unary");
    };
    let type: &Type = null;
    match (&unary) {
        &ASTUnary::AddressOf(sub) => {
            // & <sub>
            let _type_state = check_expr(scopes, sub);
            if (_type_state.please_infer) return _type_state;
            let _type = assert_is_valid(_type_state, "check_unary_expr: AddressOf expr type is invalid");
            if (_type.meta_level != 0) {
                message(todo(expr.loc, "&<type> doesn't make sense"));
            }
            type = create_base_type(BaseType::Ptr(_type));
        }
        &ASTUnary::ValueOf(sub) => {
            // * <sub>
            let _type_state = check_expr(scopes, sub);
            if (_type_state.please_infer) return _type_state;
            let _type = assert_is_valid(_type_state, "check_unary_expr: ValueOf expr type is invalid");
            if (_type.meta_level > 0) {
                _type = unwrap_meta_type(_type, 1);
                type = create_meta_type(1, BaseType::Ptr(_type));
            } else {
                let BaseType::Ptr(sub_type) = _type.base else {
                    message(todo(sub.loc, "check_unary_expr: Attempted to deref non-ptr"));
                    unreachable(); // todo terminates
                };
                type = sub_type;
            }
        }
        _ => {
            message(todo(expr.loc, "check_unary_expr: Can't check expression %", unary));
        }
    }
    return mktcs(type);
}
@trace func check_binary_expr(scopes: &GAF_List, expr: &AST) -> TCState {
    let &ASTData::Expr(ASTExpr::Binary(bin)) = &expr.data else {
        unreachable("check_binary_expr: Node is not a binary");
    };
    let lhs: &AST = null;
    let rhs: &AST = null;
    extract_operands(bin, &lhs, &rhs);

    let args = new_GAF_List(type_info(&AST));
    if (is_assignment(bin)) {
        lhs = create_expr(lhs.parent, lhs.loc, blank, ASTExpr::Unary(ASTUnary::AddressOf(lhs)));
    }
    push(&args, lhs);
    push(&args, rhs);
    let name = binary_expr_to_function_name(bin);
    let _base = create_expr(expr.parent, expr.loc, name, ASTExpr::Ident { name: name });
    expr.data = ASTData::Expr(ASTExpr::Call(_base, args));
    return check_expr(scopes, expr);
}
