import "../generated/ast.template.bufo";

// FIXME(2026-01-30): Primitive Types are scattered in multiple places around the compiler
//                    including the Lexer. Would be cool to collect that into a single place
//                    so modifications are easier to catch.
union PrimType {
    I8,
    I16,
    I32,
    I64,
    U8,
    U16,
    U32,
    U64,
    Usize,
    Bool,
    Str,
    None,
    __count,
}
func get_align(t: PrimType) -> usize {
    (comptime assert(tag(&PrimType::__count) == 12, "PrimType::get_align: Added primitive type"));
    match (t) {
        PrimType::I8    => { return 1; }
        PrimType::I16   => { return 2; }
        PrimType::I32   => { return 4; }
        PrimType::I64   => { return 8; }
        PrimType::U8    => { return 1; }
        PrimType::U16   => { return 2; }
        PrimType::U32   => { return 4; }
        PrimType::U64   => { return 8; }
        PrimType::Usize => { return 8; }
        PrimType::Bool  => { return 1; }
        PrimType::Str   => {
            let ptr = get_align(BaseType::Ptr);
            let size = get_align(PrimType::Usize);
            assert(size == ptr, "get_align(str)");
            return size;
        }
        PrimType::None => { return 1; }
        _ => {
            message(todo(blank, "get_align(PrimType): %", t));
        }
    }
    unreachable("get_align(PrimType)");
}
func get_size(t: PrimType) -> usize {
    (comptime assert(tag(&PrimType::__count) == 12, "PrimType::get_size: Added primitive type"));
    match (t) {
        PrimType::I8    => { return 1; }
        PrimType::I16   => { return 2; }
        PrimType::I32   => { return 4; }
        PrimType::I64   => { return 8; }
        PrimType::U8    => { return 1; }
        PrimType::U16   => { return 2; }
        PrimType::U32   => { return 4; }
        PrimType::U64   => { return 8; }
        PrimType::Usize => { return 8; }
        PrimType::Bool  => { return 1; }
        PrimType::Str   => {
            let ptr = get_size(BaseType::Ptr);
            let size = get_size(PrimType::Usize);
            assert(size == ptr, "get_size(str)");
            return ptr + size;
        }
        PrimType::None => { return 0; }
        _ => {
            message(todo(blank, "get_size(PrimType): %", t));
        }
    }
    unreachable("get_size(PrimType)");
}

func is_signed_integer(pt: PrimType) -> bool {
    (comptime assert(tag(&PrimType::__count) == 12, "PrimType::is_signed_integer: Added primitive type"));
    match (pt) {
        PrimType::I8    => { return true; }
        PrimType::I16   => { return true; }
        PrimType::I32   => { return true; }
        PrimType::I64   => { return true; }
        _ => { }
    }
    return false;
}

func is_number(pt: PrimType) -> bool {
    (comptime assert(tag(&PrimType::__count) == 12, "PrimType::is_number: Added primitive type"));
    match (pt) {
        PrimType::I8    => { return true; }
        PrimType::I16   => { return true; }
        PrimType::I32   => { return true; }
        PrimType::I64   => { return true; }
        PrimType::U8    => { return true; }
        PrimType::U16   => { return true; }
        PrimType::U32   => { return true; }
        PrimType::U64   => { return true; }
        PrimType::Usize => { return true; }
        _ => { }
    }
    return false;
}

func to_string(out: &String, t: PrimType) {
    let _tag = tag(&t) as usize;
    comptime names = [
        newSubStrOfStrLit("i8"),
        newSubStrOfStrLit("i16"),
        newSubStrOfStrLit("i32"),
        newSubStrOfStrLit("i64"),
        newSubStrOfStrLit("u8"),
        newSubStrOfStrLit("u16"),
        newSubStrOfStrLit("u32"),
        newSubStrOfStrLit("u64"),
        newSubStrOfStrLit("usize"),
        newSubStrOfStrLit("bool"),
        newSubStrOfStrLit("str"),
        newSubStrOfStrLit("none"),
    ];
    (comptime assert(names.length == tag(&PrimType::__count) as usize, "PrimType::to_string: Added primitive type"));
    pushSubStr(out, &names[_tag]);
}

union BaseType {
    Unknown,
    TypeDecl(&AST),
    Func(GAF_List, &Type), // Params, RetType
    Prim(PrimType),
    Ptr(&Type),
    __count,
}

func to_string(out: &String, bt: BaseType) {
    match (bt) {
        BaseType::Unknown => { pushStr(out, "<unknown>"); }
        BaseType::Func(params, ret) => {
            pushStr(out, "func (");
            for (let i: usize = 0; i < params.length; i = i + 1) {
                let p = get_ref(&params, i) as &Type;
                to_string(out, p);
                if (i != params.length - 1) {
                    pushStr(out, ", ");
                }
            }
            pushStr(out, ") -> ");
            to_string(out, ret);
        }
        BaseType::TypeDecl(node) => {
            let &ASTData::TypeDecl(struct_info) = &node.data else {
                unreachable("to_string(BaseType): Non-TypeDecl AST");
            };
            pushSubStr(out, &struct_info.name);
            if (node.parent == null) {
                if (!struct_info.state.is_monomorphized && struct_info.parameters.length > 0) {
                    // Generic struct, print as List($T)
                    pushChar(out, '(');
                    for (let i: usize = 0; i < struct_info.parameters.length; i = i + 1) {
                        if (i > 0) pushStr(out, ", ");
                        let _node = get_ref(&struct_info.parameters, i) as &AST;
                        let ASTData::Expr(ASTExpr::Generic) = _node.data else {
                            unreachable();
                        };
                        pushChar(out, '$');
                        pushSubStr(out, &_node.origin);
                    }
                    pushChar(out, ')');
                }
            }
        }
        BaseType::Prim(p) => {
            to_string(out, p);
        }
        BaseType::Ptr(sub) => {
            pushChar(out, '*');
            to_string(out, sub);
        }
        _ => {
            message(todo(blank, "to_string(BaseType): %", bt));
        }
    }
}

func get_align(t: BaseType) -> usize {
    (comptime assert(tag(&BaseType::__count) == 5, "BaseType::get_align: Added base type"));
    match (t) {
        BaseType::Ptr(_) => { return 8; }
        BaseType::Func(_, _) => { return get_align(BaseType::Ptr); }
        BaseType::Prim(pt) => { return get_align(pt); }
        BaseType::TypeDecl(str) => { return get_align(str); }
        _ => {
            message(todo(blank, "get_align(BaseType): %", t));
        }
    }
    unreachable("get_align(BaseType)");
}
func get_size(t: BaseType) -> usize {
    (comptime assert(tag(&BaseType::__count) == 5, "BaseType::get_size: Added base type"));
    match (t) {
        BaseType::Ptr(_) => { return 8; }
        BaseType::Func(_, _) => { return get_size(BaseType::Ptr); }
        BaseType::Prim(pt) => { return get_size(pt); }
        BaseType::TypeDecl(str) => { return get_size(str); }
        _ => {
            message(todo(blank, "get_size(BaseType): %", t));
        }
    }
    unreachable("get_size(BaseType)");
}

/*
 * The Type System in Bufo is split into Meta Types and Instances of them:
 * values like "3" have a meta type i32, but similarly i32 has a meta type ^i32
 * and so on. This allows us to treat types as expressions, which simplifies
 * the compiler a lot and unlocks a few options.
 * Examples:
 * Instance => Meta Type
 *       3  => i32^0
 * Type { 0, BaseType::Prim(PrimType::I32) }
 *     i32  => i32^1
 * Type { 1, BaseType::Prim(PrimType::I32) }
 *   ^i32   => i32^2
 * Type { 2, BaseType::Prim(PrimType::I32) }
 *
 *    &3    => *^0 i32^0
 * Type { 0, BaseType::Ptr(Type { 0, BaseType::Prim(PrimType::I32) } }
 *  ^* ^i32 => *^1 i32^2
 * Type { 1, BaseType::Ptr(Type { 2, BaseType::Prim(PrimType::I32) } }
 */

struct Type {
    meta_level: usize;
    base: BaseType;
}

func into_pointer_type(t: &Type) -> &Type {
    return create_meta_type(t.meta_level, BaseType::Ptr(t));
}
func get_underlying_type(pt: &Type) -> &Type {
    while let BaseType::Ptr(under) = pt.base {
        pt = under;
    }
    return pt;
}

let base_types: [Type; 12] = blank;
func create_base_type(pt: PrimType) -> &Type {
    (comptime assert(tag(&PrimType::__count) == 12, "create_base_type: Update table"));
    if (tag(&base_types[0].base) == comptime tag(&BaseType::Unknown)) {
        base_types = [
            Type { meta_level: 0, base: BaseType::Prim(PrimType::I8) },
            Type { meta_level: 0, base: BaseType::Prim(PrimType::I16) },
            Type { meta_level: 0, base: BaseType::Prim(PrimType::I32) },
            Type { meta_level: 0, base: BaseType::Prim(PrimType::I64) },
            Type { meta_level: 0, base: BaseType::Prim(PrimType::U8) },
            Type { meta_level: 0, base: BaseType::Prim(PrimType::U16) },
            Type { meta_level: 0, base: BaseType::Prim(PrimType::U32) },
            Type { meta_level: 0, base: BaseType::Prim(PrimType::U64) },
            Type { meta_level: 0, base: BaseType::Prim(PrimType::Usize) },
            Type { meta_level: 0, base: BaseType::Prim(PrimType::Bool) },
            Type { meta_level: 0, base: BaseType::Prim(PrimType::Str) },
            Type { meta_level: 0, base: BaseType::Prim(PrimType::None) },
        ];
    }
    return &base_types[tag(&pt) as usize];
}
func create_base_type(bt: BaseType) -> &Type {
    return create_meta_type(0, bt);
}
func create_meta_type(level: usize, pt: PrimType) -> &Type {
    return create_meta_type(level, BaseType::Prim(pt));
}
func create_meta_type(level: usize, bt: BaseType) -> &Type {
    return wrap(Type { meta_level: level, base: bt });
}
func unwrap_meta_type(t: &Type, level: usize) -> &Type {
    assert(t.meta_level != 0, "unwrap_meta_type: Type is not a meta type");
    assert(level >= t.meta_level, "unwrap_meta_type: Type doesn't have enough levels");
    return create_meta_type(t.meta_level - level, t.base);
}
func wrap_meta_type(t: &Type, level: usize) -> &Type {
    return create_meta_type(t.meta_level + level, t.base);
}

func get_builtin_type(name: SubStr) -> &Type {
    let map = [
        (comptime newSubStrOfStrLit("i8"),    BaseType::Prim(PrimType::I8)),
        (comptime newSubStrOfStrLit("i16"),   BaseType::Prim(PrimType::I16)),
        (comptime newSubStrOfStrLit("i32"),   BaseType::Prim(PrimType::I32)),
        (comptime newSubStrOfStrLit("i64"),   BaseType::Prim(PrimType::I64)),
        (comptime newSubStrOfStrLit("u8"),    BaseType::Prim(PrimType::U8)),
        (comptime newSubStrOfStrLit("u16"),   BaseType::Prim(PrimType::U16)),
        (comptime newSubStrOfStrLit("u32"),   BaseType::Prim(PrimType::U32)),
        (comptime newSubStrOfStrLit("u64"),   BaseType::Prim(PrimType::U64)),
        (comptime newSubStrOfStrLit("usize"), BaseType::Prim(PrimType::Usize)),
        (comptime newSubStrOfStrLit("bool"),  BaseType::Prim(PrimType::Bool)),
        (comptime newSubStrOfStrLit("str"),   BaseType::Prim(PrimType::Str)),
        (comptime newSubStrOfStrLit("none"),  BaseType::Prim(PrimType::None)),
    ];
    assert(map.length == tag(&PrimType::__count) as usize, "get_builtin_type: Added primitive type");
    for (let i: usize = 0; i < map.length; i = i + 1) {
        if (equals(&map[i].0, &name)) {
            return create_meta_type(1, map[i].1);
        }
    }
    message(todo(blank, "get_builtin_type: Unknown type name %", name));
    unreachable(); // todo terminates
}

func to_string(t: &Type) -> String {
    let s: String = blank;
    to_string(&s, t);
    return s;
}

func to_string(out: &String, t: &Type) {
    if (t == null) {
        format(out, "(null)");
        return;
    }
    for (let i: usize = 0; i < t.meta_level; i = i + 1) {
        format(out, "^");
    }
    to_string(out, t.base);
}

func get_align(t: &Type) -> usize {
    if (t.meta_level == 0) return get_align(t.base);
    message(todo(blank, "get_align of meta type %", t.base));
    unreachable();
}
func get_size_in_bits(t: &Type) -> usize {
    return get_size(t) * 8;
}
func get_size(t: &Type) -> usize {
    if (t.meta_level == 0) return get_size(t.base);
    message(todo(blank, "get_size of meta type %", *t));
    unreachable();
}

func is_unknown(t: &Type) -> bool {
    if let BaseType::Unknown = t.base {
        return true;
    }
    return false;
}

func is_signed_integer(t: &Type) -> bool {
    let BaseType::Prim(pt) = t.base else {
        return false;
    };
    return is_signed_integer(pt);
}

func is_number(t: &Type) -> bool {
    let BaseType::Prim(pt) = t.base else {
        return false;
    };
    return is_number(pt);
}

func is_pointer(type: &Type) -> bool {
    if let BaseType::Ptr(_) = type.base {
        return true;
    }
    return false;
}

func call_type_matches_function_type(call_type: &Type, function_type: &Type) -> bool {
    if (call_type == null || function_type == null) return false;
    if (call_type.meta_level != function_type.meta_level) return false;
    let (BaseType::Func(args, wanted_ret), BaseType::Func(params, ret_type)) = (call_type.base, function_type.base) else {
        return false;
    };
    if (args.length != params.length) return false;
    for (let i: usize = 0; i < args.length; i = i + 1) {
        let arg_type = get_ref(&args, i) as &Type;
        let par_type = get_ref(&params, i) as &Type;
        par_type = unwrap_meta_type(par_type, 1);
        if (!is_convertible_to(arg_type, par_type)) return false;
    }
    ret_type = unwrap_meta_type(ret_type, 1);
    return is_convertible_to(wanted_ret, ret_type);
}

func is_equal_to(t1: &Type, t2: &Type) -> bool {
    if (t1 == null || t2 == null) return false;
    // A == A
    if (t1 == t2) return true;
    // A -> B
    if (!is_convertible_to(t1, t2)) return false;
    // B -> A
    if (!is_convertible_to(t2, t1)) return false;
    // A == B
    return true;
}

func is_convertible_to(t1: &Type, t2: &Type) -> bool {
    if (t1 == t2) return true;
    if (t1.meta_level != t2.meta_level) return false;
    // REVIEW(2026-03-03): Can we find a more elegant way for this?
    match ((&t1.base, &t2.base)) {
        (&BaseType::Prim(pt1), &BaseType::Prim(pt2)) => { return tag(&pt1) == tag(&pt2); }
        (&BaseType::TypeDecl(s1), &BaseType::TypeDecl(s2)) => { return s1 == s2; }
        (&BaseType::Ptr(p1), &BaseType::Ptr(p2)) => { return is_convertible_to(p1, p2); }
        (&BaseType::Func(p1, r1), &BaseType::Func(p2, r2)) => {
            if (p1.length != p2.length) return false;
            if (!is_convertible_to(r1, r2)) return false;
            for (let i: usize = 0; i < p1.length; i = i + 1) {
                let _p1 = get_ref(&p1, i) as &Type;
                let _p2 = get_ref(&p2, i) as &Type;
                if (!is_convertible_to(_p1, _p2)) return false;
            }
            return true;
        }
        (&BaseType::Unknown, _) => { return true; }
        (_, _) => { }
    }
    return false;
}
