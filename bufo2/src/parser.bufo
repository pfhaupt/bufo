
import "prelude.bufo";
import "libc.bufo";
import "type_info.bufo";
import "string.bufo";
import "substr.bufo";
import "format.bufo";

import "list.bufo";
import "hashmap.bufo";

import "common.bufo";
import "corot.bufo";
import "lexer.bufo";
import "ast.bufo";
import "checker.bufo";
import "type.bufo";
import "lookup.bufo";
import "codegen.bufo";
import "interp.bufo";

import "../generated/ast.template.bufo";

struct Insert_Context {
    parse_fn: func (&Parse_Context) -> (bool, &AST);
    parent: &AST;
    generic_type_mapping: GAF_HashMap; // HashMap<Ident, Type>
}

struct Parse_Context {
    parent: &AST;
    lexer: Lexer;
    generic_type_mapping: GAF_HashMap; // HashMap<Ident, Type>
    insert_context: Insert_Context;
}

@trace func new_generic_type_mapping() -> GAF_HashMap {
    return new_hashmap_with_substr_key(type_info(&Type));
}

struct Load_Context {
    current_module: &AST;
    file_name: SubStr;
    loc: Loc;
    main_file: bool;
}

let loaded_files: GAF_HashMap = blank;

@trace func load_file(context: &Load_Context) {
    if (loaded_files.key_type_size == 0) {
        loaded_files = new_hashmap_with_string_key(type_info(bool));
    }
    let file_name = context.file_name;
    let _file = toString(&file_name);
    let full_path = toAbsolutePath(&_file);
    drop(&_file);
    if (contains(&loaded_files, full_path)) {
        return;
    }
    let source: String = blank;
    if (!canReadFileToString(asSubStr(&full_path), &source)) {
        message(error(context.loc, "Could not read file %", file_name));
    }
    add(&loaded_files, full_path, true);
    if (context.current_module == null) {
        assert(context.main_file, "load_file: Current Module is null but we're also not in the main file");
        context.current_module = create_module(null, new_loc(file_name, 0), asSubStr(&source), comptime newSubStr("__global__"));
        context.current_module.super_node = context.current_module;
    }
    // REVIEW(2026-07-28): To make life easier for ourselves this should not spawn
    //                     Otherwise we can't know later on, when we encounter symbols,
    //                     if we can take *that* symbol or should wait for potential loads.
    let file = spawn(parse_file, wrap((context.current_module, source, file_name)));
}

@trace func parse_file(arg: &(&AST, String, SubStr)) {
    let parent = arg.0;
    let src = arg.1;
    let file_name = arg.2;
    let slice = asSubStr(&src);
    assert(slice.len != 0, "Empty source");
    let lexer = Lexer {
        file_name: file_name,
        offset_in_file: 0,
        source: slice,
    };
    let context = Parse_Context {
        parent: parent,
        lexer: lexer,
        generic_type_mapping: blank,
    };
    let _ = spawn(__parse_module_body, wrap(context));
}

@trace func __parse_module_body(ctx: &Parse_Context) {
    let mod = get_module_info(ctx.parent);
    register_monitor(&mod.state.did_parse_everything);

    let module_source = ctx.lexer.source;
    let __parse_type_decl = func (ctx: &Parse_Context, tkn: Token) {
        let slice = ctx.lexer.source;
        let offset_in_file = ctx.lexer.offset_in_file;
        let start = expect(&ctx.lexer, TokenData::KeywordType, TokenData::KeywordStruct, TokenData::KeywordUnion);
        let _name = expect(&ctx.lexer, TokenData::Ident);
        if (lexer_at(&ctx.lexer, TokenData::ParenOpen)) {
            skip_until_matching(&ctx.lexer, TokenData::ParenOpen, TokenData::ParenClose);
        }
        let end = skip_until_matching(&ctx.lexer, TokenData::CurlyOpen, TokenData::CurlyClose);
        let source = substring(&slice, start.loc.offset - offset_in_file, end.loc.offset - offset_in_file + 1);
        let type_decl_node = create_type_decl(ctx.parent, _name.loc, source, get_name(&_name));
        type_decl_node.super_node = type_decl_node;
        let _lexer = Lexer {
            offset_in_file: tkn.loc.offset,
            file_name: tkn.loc.file,
            source: source,
        };
        let context = Parse_Context {
            parent: type_decl_node,
            lexer: _lexer,
            generic_type_mapping: blank,
        };
        let _ = spawn(parse_type_decl, wrap(context));
    };
    while (!lexer_at(&ctx.lexer, TokenData::CurlyClose, TokenData::EndOfFile)) {
        let leftover_source = ctx.lexer.source;
        let offset_in_file = ctx.lexer.offset_in_file;
        let tkn = peek(&ctx.lexer);
        match (tkn.data) {
            TokenData::Hash => {
                expect(&ctx.lexer, TokenData::Hash);
                let _name = expect(&ctx.lexer, TokenData::Ident);
                let dir_name = get_name(&_name);
                if (equals(&dir_name, &comptime newSubStrOfStrLit("load"))) {
                    let _file = expect(&ctx.lexer, TokenData::StringLiteral);
                    let TokenData::StringLiteral { origin, value } = _file.data else {
                        unreachable();
                    };
                    expect(&ctx.lexer, TokenData::SemiColon);
                    load_file(wrap(Load_Context {
                        current_module: ctx.parent,
                        file_name: asSubStr(&value),
                        loc: _file.loc,
                    }));
                } else {
                    message(error(_name.loc, "Invalid top level directive %.", dir_name));
                }
            }
            TokenData::KeywordType => {
                __parse_type_decl(ctx, tkn);
            }
            TokenData::KeywordStruct => {
                __parse_type_decl(ctx, tkn);
            }
            TokenData::KeywordUnion => {
                __parse_type_decl(ctx, tkn);
            }
            TokenData::KeywordModule => {
                expect(&ctx.lexer, TokenData::KeywordModule);
                let _name = expect(&ctx.lexer, TokenData::Ident);
                let end = skip_until_matching(&ctx.lexer, TokenData::CurlyOpen, TokenData::CurlyClose);
                let source = substring(&leftover_source, tkn.loc.offset - offset_in_file, end.loc.offset - offset_in_file + 1);
                let mod_node = create_module(ctx.parent, _name.loc, source, get_name(&_name));
                mod_node.super_node = mod_node;
                let _lexer = Lexer {
                    offset_in_file: tkn.loc.offset,
                    file_name: tkn.loc.file,
                    source: source,
                };
                let context = Parse_Context {
                    parent: mod_node,
                    lexer: _lexer,
                    generic_type_mapping: blank,
                };
                let _ = spawn(parse_module, wrap(context));
            }
            TokenData::KeywordFunc => {
                expect(&ctx.lexer, TokenData::KeywordFunc);
                let _name = expect(&ctx.lexer, TokenData::Ident);
                skip_until_matching(&ctx.lexer, TokenData::ParenOpen, TokenData::ParenClose);
                while (!lexer_at(&ctx.lexer, TokenData::CurlyOpen)) next(&ctx.lexer);
                let end = skip_until_matching(&ctx.lexer, TokenData::CurlyOpen, TokenData::CurlyClose);
                // func foo ( ) { } .......
                // ^offset_in_file
                //                ^end.offset_in_file
                // + 1 because the curly bracket is also contained
                let source = substring(&leftover_source, tkn.loc.offset - offset_in_file, end.loc.offset - offset_in_file + 1);
                let func_node = create_function(ctx.parent, _name.loc, source, get_name(&_name));
                func_node.super_node = func_node;
                let _lexer = Lexer {
                    offset_in_file: tkn.loc.offset,
                    file_name: tkn.loc.file,
                    source: source,
                };
                let context = Parse_Context {
                    parent: func_node,
                    lexer: _lexer,
                    generic_type_mapping: blank,
                };
                let _ = spawn(parse_function_signature, wrap(context));
            }
            t => {
                // TODO(2026-07-28): Error recovery.
                message(error(tkn.loc, "Unexpected top level token %.", to_cstr(t)));
            }
        }
    }
    mod.state.did_parse_everything = true;
    unregister_monitor(&mod.state.did_parse_everything);
}

@trace func parse_module(ctx: &Parse_Context) {
    expect(&ctx.lexer, TokenData::KeywordModule);
    let _name = expect(&ctx.lexer, TokenData::Ident);
    expect(&ctx.lexer, TokenData::CurlyOpen);
    __parse_module_body(ctx);
    let end = expect(&ctx.lexer, TokenData::CurlyClose);
}

@trace func parse_type_decl_with_mapping(ast: &AST, mapping: GAF_HashMap) -> &AST {
    let _lexer = Lexer {
        offset_in_file: ast.loc.offset,
        file_name: ast.loc.file,
        source: ast.origin,
    };
    expect(&_lexer, TokenData::KeywordType, TokenData::KeywordStruct, TokenData::KeywordUnion);
    let _name = expect(&_lexer, TokenData::Ident);

    // Generic Parameters are ignored here, as we got a mapping.
    if (lexer_at(&_lexer, TokenData::ParenOpen)) {
        skip_until_matching(&_lexer, TokenData::ParenOpen, TokenData::ParenClose);
    }

    let &ASTData::TypeDecl(type_decl_state) = &ast.data else {
        unreachable("parse_type_decl_with_mapping called with non-type_decl AST");
    };
    type_decl_state.state.did_parse_signature = true;
    // FIXME(2026-07-08): I am not happy that we have to do this here, but it is what it is.
    register_monitor(&type_decl_state.state.did_parse_signature);
    unregister_monitor(&type_decl_state.state.did_parse_signature);

    ast.super_node = ast;
    let context = Parse_Context {
        parent: ast,
        lexer: _lexer,
        generic_type_mapping: mapping,
    };
    let cid = spawn(parse_type_decl_body, wrap(context));
    handle_corot_result(wait(cid),
        error(ast.loc, "Could not monomorphize type declaration due to a cyclic dependency on %.", corot_str(cid)),
        note(ast.loc, "...while monomorphizing this type declaration."));
    return ast;
}

@trace func parse_type_decl(_context: &Parse_Context) {
    let context = *_context;
    let lexer = &context.lexer;
    let type_decl_node = context.parent;
    expect(lexer, TokenData::KeywordType, TokenData::KeywordStruct, TokenData::KeywordUnion);
    let _name = expect(lexer, TokenData::Ident);
    let name = get_name(&_name);
    let &ASTData::TypeDecl(type_decl_state) = &type_decl_node.data else {
        unreachable();
    };

    register_monitor(&type_decl_state.state.did_parse_signature);

    type_decl_state.parameters = parse_generic_parameters(&context);
    type_decl_state.state.did_parse_signature = true;
    unregister_monitor(&type_decl_state.state.did_parse_signature);

    if (!is_generic(&type_decl_state)) {
        let cid = spawn(parse_type_decl_body, wrap(Parse_Context {
            parent: type_decl_node,
            lexer: *lexer,
            generic_type_mapping: blank,
        }));
        handle_corot_result(wait(cid),
            error(type_decl_node.loc, "Could not parse type declaration body due to a cyclic dependency on %.", corot_str(cid)),
            note(type_decl_node.loc, "...while parsing this type declaration body."));
    }
}

@trace func parse_type_decl_body(context: &Parse_Context) {
    let lexer = &context.lexer;
    let type_decl_node = context.parent;
    let type_decl_state = get_type_decl_info(type_decl_node);
    let parent_module = type_decl_node.parent;
    assert(parent_module != null, "parse_type_decl_body: Parent is null");

    register_monitor(&type_decl_state.size_in_bytes);
    register_monitor(&type_decl_state.align_in_bytes);
    register_monitor(&type_decl_state.tag_offset);
    register_monitor(&type_decl_state.state.did_parse_fields);
    register_monitor(&type_decl_state.state.did_parse_variants);
    register_monitor(&type_decl_state.state.did_check_fields);
    register_monitor(&type_decl_state.state.did_check_variants);

    expect(lexer, TokenData::CurlyOpen);
    while (!lexer_at(lexer, TokenData::CurlyClose)) {
        let name = expect(lexer, TokenData::Ident);
        let TokenData::Ident { _name } = name.data else { unreachable(); };
        if (eat(lexer, TokenData::ColonSingle)) {
            let (generic, type) = parse_type(context);
            assert(!generic, "parse_type_decl_body: Expected resolved generics at this point");
            add_field(type_decl_node, type_decl_state, name.loc, _name, type);
        } else if (eat(lexer, TokenData::ParenOpen)) {
            let variant_fields = new_GAF_List(type_info(&AST));
            while (!lexer_at(lexer, TokenData::ParenClose)) {
                let (generic, type) = parse_type(context);
                assert(!generic, "parse_type_decl_body: Expected resolved generics at this point");
                push(&variant_fields, type);
                if (!lexer_at(lexer, TokenData::ParenClose)) {
                    expect(lexer, TokenData::Comma);
                }
            }
            expect(lexer, TokenData::ParenClose);
            if (variant_fields.length == 0) {
                message(error(name.loc, "Unexpected parentheses in empty type variant."));
            }
            add_variant(type_decl_node, type_decl_state, name.loc, _name, variant_fields);
        } else if (lexer_at(lexer, TokenData::SemiColon)) {
            add_variant(type_decl_node, type_decl_state, name.loc, _name, blank);
        } else {
            message(todo(name.loc, "unexpected token"));
        }
        if (!lexer_at(lexer, TokenData::CurlyClose)) {
            expect(lexer, TokenData::SemiColon);
        }
    }
    type_decl_state.state.did_parse_fields = true;
    unregister_monitor(&type_decl_state.state.did_parse_fields);
    type_decl_state.state.did_parse_variants = true;
    unregister_monitor(&type_decl_state.state.did_parse_variants);

    for (let i: usize = 0; i < type_decl_state.variants.length; i = i + 1) {
        let variant: &ASTTypeDeclVariant = get_ref_raw(&type_decl_state.variants, i);
        register_monitor(&variant.size_in_bytes);
        register_monitor(&variant.align_in_bytes);
    }

    check_type_decl(parent_module, type_decl_node);
}

@trace func parse_generic_parameters(context: &Parse_Context) -> GAF_List {
    let lexer = &context.lexer;
    let parameters = new_GAF_List(type_info(&AST));
    if (eat(lexer, TokenData::ParenOpen)) {
        while (!lexer_at(lexer, TokenData::ParenClose)) {
            let (_, param) = parse_type(context);
            let &ASTData::Expr(ASTExpr::Generic) = &param.data else {
                message(todo(param.loc, "Parameter must be $Generic"));
                unreachable(); // todo() terminates
            };
            push(&parameters, param);
            if (!lexer_at(lexer, TokenData::ParenClose)) {
                expect(lexer, TokenData::Comma);
            }
        }
        expect(lexer, TokenData::ParenClose);
    }
    return parameters;
}

@trace func parse_attribute(context: &Parse_Context) -> ASTAttr {
    expect(&context.lexer, TokenData::At);
    let tkn = expect(&context.lexer, TokenData::Ident);
    let TokenData::Ident { attribute } = tkn.data else {
        unreachable("expected ident");
    };
    let attrs = [
        (comptime newSubStrOfStrLit("expand"), func (context: &Parse_Context) -> ASTAttrData {
            return ASTAttrData::Expand;
        }),
        (comptime newSubStrOfStrLit("naked"), func (context: &Parse_Context) -> ASTAttrData {
            return ASTAttrData::Naked;
        }),
    ];
    for (let i: usize = 0; i < attrs.length; i = i + 1) {
        if (equals(&attribute, &attrs[i].0)) {
            return ASTAttr {
                name: attribute,
                loc: tkn.loc,
                data: attrs[i].1(context),
            };
        }
    }
    message(error(tkn.loc, "Use of unknown attribute `%`.", attribute));
    unreachable("parse_attribute"); // error terminates
}

@trace func parse_function_attributes(context: &Parse_Context) {
    let func_node = context.parent;
    let attributes = new_GAF_List(type_info(ASTAttr));
    while (!lexer_at(&context.lexer, TokenData::CurlyOpen)) {
        let attr = parse_attribute(context);
        if (!is_function_attribute(attr)) {
            message(error(attr.loc, "Attribute `%` cannot be used on functions.", attr.name));
        }
        push(&attributes, attr);
    }
    func_node.attributes = attributes;
}

@trace func parse_function_with_mapping(ast: &AST, mapping: GAF_HashMap) -> &AST {
    let _lexer = Lexer {
        offset_in_file: ast.loc.offset,
        file_name: ast.loc.file,
        source: ast.origin,
    };
    ast.super_node = ast;
    let context = Parse_Context {
        parent: ast,
        lexer: _lexer,
        generic_type_mapping: mapping,
    };
    let func_state = get_func_info(context.parent);

    let cid = spawn(parse_function_signature, wrap(context));
    handle_corot_result(wait(cid),
        error(ast.loc, "Could not monomorphize function due to a cyclic dependency on %.", corot_str(cid)),
        note(ast.loc, "...while monomorphizing the function %.", func_state.name));

    return ast;
}

@trace func parse_function_signature(_context: &Parse_Context) {
    let context = *_context;
    let lexer = &context.lexer;
    let func_node = context.parent;
    expect(lexer, TokenData::KeywordFunc);
    let _name = expect(lexer, TokenData::Ident);
    let func_state = get_func_info(func_node);

    register_monitor(&func_state.state.did_parse_signature);

    expect(lexer, TokenData::ParenOpen);
    while (!lexer_at(lexer, TokenData::ParenClose)) {
        parse_parameter(&context, &func_node.data);
        if (!lexer_at(lexer, TokenData::ParenClose)) {
            expect(lexer, TokenData::Comma);
        }
    }
    expect(lexer, TokenData::ParenClose);
    if (eat(lexer, TokenData::Arrow)) {
        let (has_generic, return_type) = parse_type(&context);
        if (has_generic) {
            func_state.state.is_generic = true;
        }
        func_state.return_type = return_type;
    } else {
        comptime name = newSubStrOfStrLit("none");
        func_state.return_type = create_expr(context.parent, func_node.loc, name, ASTExpr::BuiltinType { name: name });
    }
    parse_function_attributes(&context);
    func_state.state.did_parse_signature = true;
    unregister_monitor(&func_state.state.did_parse_signature);

    if (!func_state.state.is_generic) {
        let cid = spawn(parse_function_body, wrap(Parse_Context {
            parent: context.parent,
            lexer: *lexer,
            generic_type_mapping: context.generic_type_mapping,
        }));
        handle_corot_result(wait(cid),
            error(func_node.loc, "Could not parse function body due to a cyclic dependency on %.", corot_str(cid)),
            note(func_node.loc, "...while parsing the body of function %.", func_state.name));
    }
}

@trace func parse_parameter(context: &Parse_Context, func_node: &ASTData) {
    let &ASTData::Function(func_state) = func_node else { unreachable(); };
    let name = expect(&context.lexer, TokenData::Ident);
    let TokenData::Ident { _name } = name.data else { unreachable(); };
    expect(&context.lexer, TokenData::ColonSingle);
    let (has_generic, type) = parse_type(context);
    if (has_generic) func_state.state.is_generic = true;
    let param = create_node(context.parent, type.loc, _name);
    param.data = ASTData::Param(type);
    push(&func_state.params, param);
}

@trace func parse_function_body(context: &Parse_Context) {
    let func_node = context.parent;
    let func_state = get_func_info(func_node);
    let parent_module = func_node.parent;
    assert(parent_module != null, "parse_function_body: Parent is null");
    register_monitor(&func_node.type);
    register_monitor(&func_state.block);
    register_monitor(&func_state.state.did_parse_body);
    register_monitor(&func_state.state.did_check_body);
    register_monitor(&func_state.state.did_codegen_body);
    register_monitor(&func_state.state.did_check_signature);

    assert(func_state.scopes.length == 0, "Function already has scopes");
    push(&func_state.scopes, new_stack());

    check_function_parameters(parent_module, func_state);
    check_function_return_type(parent_module, func_state);
    func_state.state.did_check_signature = true;
    unregister_monitor(&func_state.state.did_check_signature);
    finalize_function_type(func_node, func_state);

    codegen_function_entry(func_node);

    expect(&context.lexer, TokenData::CurlyOpen);
    let (is_generic, block) = parse_block(context);
    assert(!is_generic, "parse_function_body: Unexpected generics in function");
    expect(&context.lexer, TokenData::EndOfFile);
    func_state.block = block;
    func_state.state.did_parse_body = true;
    unregister_monitor(&func_state.state.did_parse_body);

    check_block(parent_module, block);
    func_state.state.did_check_body = true;
    unregister_monitor(&func_state.state.did_check_body);

    codegen_expr(func_state, block, false);
    func_state.state.did_codegen_body = true;
    unregister_monitor(&func_state.state.did_codegen_body);

    codegen_function_exit(func_node);

    pop(&func_state.scopes);
    assert(func_state.scopes.length == 0, "parse_function_body: Stack not empty");

    message(dbg(func_node.loc, "Parsed, type checked and generated function %", func_state.name));
}

@trace func parse_block(context: &Parse_Context) -> (bool, &AST) {
    let old_parent = context.parent;
    let loc = new_loc(context.lexer.file_name, context.lexer.offset_in_file);

    let block_expr = context.parent = create_expr(context.parent, loc, blank, ASTExpr::BlockExpr); // dummy block
    let block = new_GAF_List(type_info(&AST));
    let value: &AST = null;

    let fn = get_parent_function(context.parent);
    let func_state = get_func_info(fn);

    push(&func_state.scopes, new_stack());

    let is_generic = false;
    while (!lexer_at(&context.lexer, TokenData::CurlyClose)) {
        let (gen_stmt, stmt) = parse_stmt(context);
        if (gen_stmt) is_generic = true;
        if (lexer_at(&context.lexer, TokenData::CurlyClose)) {
            match (&stmt.data) {
                &ASTData::Stmt(ASTStmt::Expr(expr)) => { value = expr; }
                &ASTData::Stmt(ASTStmt::Directive(dir)) => {
                    value = create_expr(context.parent, stmt.loc, blank, ASTExpr::Directive(dir));
                }
                _ => {
                    expect(&context.lexer, TokenData::SemiColon);
                    unreachable(); // We know that we're lexer_at a {
                }
            }
            value.parent = context.parent;
        } else {
            if (!is_block(stmt) && !is_if(stmt)) expect(&context.lexer, TokenData::SemiColon);
            push(&block, stmt);
        }
    }
    expect(&context.lexer, TokenData::CurlyClose);

    if (value != null) {
        block_expr.data = ASTData::Expr(ASTExpr::BlockExpr(block, value));
    } else {
        block_expr.data = ASTData::Expr(ASTExpr::BlockVoid(block));
    }

    block_expr.parent = context.parent = old_parent;

    pop(&func_state.scopes);

    return (is_generic, block_expr);
}

@trace func parse_stmt(context: &Parse_Context) -> (bool, &AST) {
    let old_parent = context.parent;
    let old = context.insert_context;
    context.insert_context = Insert_Context {
        parse_fn: parse_stmt,
        parent: context.parent,
        generic_type_mapping: context.generic_type_mapping,
    };
    let tkn = peek(&context.lexer);
    let __parse_var_decl = func (context: &Parse_Context) -> (SubStr, &AST, &AST, &AST, bool) {
        let pat = parse_pattern(context);
        let expr: &AST = null;
        let trampoline: &AST = null;
        let origin = pat.origin;
        let end = origin.start + origin.len;
        let is_generic = false;
        if (eat(&context.lexer, TokenData::EqualSingle)) {
            let (gen_expr, _expr) = parse_expr(context);
            if (gen_expr) is_generic = true;
            expr = _expr;
            end = expr.origin.start + expr.origin.len;
            if (eat(&context.lexer, TokenData::KeywordElse)) {
                expect(&context.lexer, TokenData::CurlyOpen);
                let (gen_tramp, _tramp) = parse_block(context);
                if (gen_tramp) is_generic = true;
                trampoline = _tramp;
                end = trampoline.origin.start + trampoline.origin.len;
            }
        }
        origin.len = end - origin.start;
        return (origin, pat, expr, trampoline, is_generic);
    };
    let stmt = context.parent = create_stmt(context.parent, tkn.loc, blank, ASTStmt::Let); // dummy statement
    let is_generic = false;
    match (tkn.data) {
        TokenData::KeywordLet => {
            next(&context.lexer);
            let (origin, pat, expr, trampoline, gen_decl) = __parse_var_decl(context);
            is_generic = gen_decl;
            stmt.data = ASTData::Stmt(ASTStmt::Let {
                pat: pat,
                expr: expr,
                trampoline: trampoline
            });
        }
        TokenData::KeywordComptime => {
            next(&context.lexer);
            let (origin, pat, expr, trampoline, gen_decl) = __parse_var_decl(context);
            is_generic = gen_decl;
            stmt.data = ASTData::Stmt(ASTStmt::Comptime {
                pat: pat,
                expr: expr,
                trampoline: trampoline
            });
        }
        TokenData::KeywordReturn => {
            next(&context.lexer);
            if (!lexer_at(&context.lexer, TokenData::SemiColon)) {
                let (gen_expr, expr) = parse_expr(context);
                is_generic = gen_expr;
                stmt.data = ASTData::Stmt(ASTStmt::ReturnExpr(expr));
            } else {
                stmt.data = ASTData::Stmt(ASTStmt::ReturnVoid);
            }
        }
        TokenData::Hash => {
            next(&context.lexer);
            let (gen_dir, dir) = parse_directive(context);
            is_generic = gen_dir;
            stmt.data = ASTData::Stmt(ASTStmt::Directive(dir));
        }
        _ => {
            let (gen_expr, expr) = parse_expr(context);
            is_generic = gen_expr;
            stmt.data = ASTData::Stmt(ASTStmt::Expr(expr));
        }
    }
    stmt.parent = context.parent = old_parent;
    context.insert_context = old;
    return (is_generic, stmt);
}

@trace func parse_pattern(context: &Parse_Context) -> &AST {
    let tkn = next(&context.lexer);
    let ret_pat: &AST = null;
    match (tkn.data) {
        TokenData::Ident { name } => {
            ret_pat = create_pattern(context.parent, tkn.loc, name, ASTPat::Ident(name));
        }
        _ => {
            message(todo(tkn.loc, "unknown pattern"));
        }
    }
    assert(ret_pat != null, "parse_pattern");
    let origin = ret_pat.origin;
    if (eat(&context.lexer, TokenData::ColonSingle)) {
        let (has_generic, type) = parse_type(context);
        assert(!has_generic, "parse_pattern: Generics should be resolved lexer_at this point");
        let end = type.origin.start + type.origin.len;
        origin.len = end - origin.start;
        ret_pat = create_pattern(context.parent, tkn.loc, origin, ASTPat::PatWithType(ret_pat, type));
    }
    return ret_pat;
}

@trace func parse_type(context: &Parse_Context) -> (bool, &AST) {
    // NOTE(2026-07-08): Types can be any expression that doesn't include `=` or lower things like
    //                   `+=`. Actually we only care about Equals, because otherwise `let a: i32 = 1;`
    //                   would be ambiguous, but at the same time, does `let a: i32 += 1;` make sense?
    let min_precedence = get_binary_precedence(TokenData::EqualSingle) + 1;
    let (gen_expr, type) = __parse_expr(context, min_precedence);
    // REVIEW(2026-06-05): Limit what we accept here?
    return (gen_expr, type);
}

@trace func parse_expr(context: &Parse_Context) -> (bool, &AST) {
    return __parse_expr(context, 0);
}
@trace func __parse_expr(context: &Parse_Context, min_precedence: usize) -> (bool, &AST) {
    let old = context.insert_context;
    context.insert_context = Insert_Context {
        parse_fn: parse_expr,
        parent: context.parent,
        generic_type_mapping: context.generic_type_mapping,
    };
    let (is_generic, expr) = __parse_expr(context, min_precedence, Assoc::Left);
    expr.parent = context.parent;
    context.insert_context = old;
    return (is_generic, expr);
}

union Assoc { Left, Right }

@trace func matches_unary_expr(context: &Parse_Context) -> bool {
    (comptime assert(tag(&TokenData::EndOfFile) == 50, "Parser::matches_unary_expr: Added more tokens"));
    match (peek(&context.lexer).data) {
        TokenData::MinusSingle     => { return true; }
        TokenData::AmpersandSingle => { return true; }
        TokenData::AmpersandDouble => { return true; }
        TokenData::AsteriskSingle  => { return true; }
        TokenData::Bang            => { return true; }
        TokenData::Hash            => { return true; }
        _ => { return false; }
    }
    unreachable("matches_unary_expr");
}
@trace func matches_binary_expr(context: &Parse_Context) -> bool {
    (comptime assert(tag(&TokenData::EndOfFile) == 50, "Parser::matches_binary_expr: Added more tokens"));
    match (peek(&context.lexer).data) {
        TokenData::ParenOpen      => { return true; }
        TokenData::KeywordAs      => { return true; }
        TokenData::MinusSingle    => { return true; }
        TokenData::PlusSingle     => { return true; }
        TokenData::AsteriskSingle => { return true; }
        TokenData::EqualDouble    => { return true; }
        TokenData::PlusEqual      => { return true; }
        TokenData::MinusEqual     => { return true; }
        TokenData::AsteriskEqual  => { return true; }
        TokenData::SlashEqual     => { return true; }
        TokenData::EqualSingle    => { return true; }
        TokenData::NotEqual       => { return true; }
        TokenData::GreaterThan    => { return true; }
        TokenData::GreaterEqual   => { return true; }
        TokenData::LessThan       => { return true; }
        TokenData::LessEqual      => { return true; }
        TokenData::Dot            => { return true; }
        _ => { return false; }
    }
    unreachable("matches_binary_expr");
}
@trace func get_binary_precedence(tkn: TokenData) -> usize {
    (comptime assert(tag(&TokenData::EndOfFile) == 50, "Parser::get_binary_precedence: Added more tokens"));
    (comptime assert(tag(&ASTBinary::__count) == 15, "get_binary_precedence: Added more Operands"));
    match (tkn) {
        TokenData::Dot            => { return 17; }
        TokenData::ParenOpen      => { return 16; }
        TokenData::SlashSingle    => { return 12; }
        TokenData::AsteriskSingle => { return 12; }
        TokenData::PlusSingle     => { return 11; }
        TokenData::MinusSingle    => { return 11; }
        TokenData::LessThan       => { return 9; }
        TokenData::LessEqual      => { return 9; }
        TokenData::GreaterThan    => { return 9; }
        TokenData::GreaterEqual   => { return 9; }
        TokenData::EqualDouble    => { return 8; }
        TokenData::NotEqual       => { return 8; }
        TokenData::EqualSingle    => { return 2; }
        TokenData::PlusEqual      => { return 2; }
        TokenData::MinusEqual     => { return 2; }
        TokenData::AsteriskEqual  => { return 2; }
        TokenData::SlashEqual     => { return 2; }
        _ => { }
    }
    unreachable("get_binary_precedence");
}
@trace func get_binary_associativity(tkn: Token) -> Assoc {
    (comptime assert(tag(&ASTBinary::__count) == 15, "get_binary_associativity: Added more Operands"));
    match (tkn.data) {
        TokenData::EqualSingle    => { return Assoc::Right; }
        TokenData::PlusEqual      => { return Assoc::Right; }
        TokenData::MinusEqual     => { return Assoc::Right; }
        TokenData::AsteriskEqual  => { return Assoc::Right; }
        TokenData::SlashEqual     => { return Assoc::Right; }
        _ => { }
    }
    return Assoc::Left;
}

@trace func get_unary_precedence(tkn: TokenData) -> usize {
    (comptime assert(tag(&TokenData::EndOfFile) == 50, "Parser::get_unary_precedence: Added more tokens"));
    (comptime assert(tag(&ASTUnary::__count) == 3, "Parser::get_unary_precedence: Added more Operands"));
    match (tkn) {
        TokenData::AsteriskSingle  => { return 14; }
        TokenData::AmpersandSingle => { return 14; }
        TokenData::Bang            => { return 14; }
        TokenData::Hash            => { return 0; }
        _ => { }
    }
    unreachable("get_unary_precedence");
}

@trace func __parse_expr(context: &Parse_Context, precedence: usize, associativity: Assoc) -> (bool, &AST) {
    let _start = peek(&context.lexer);
    let is_generic = false;
    let (gen_prim, expr) = parse_primary_expr(context);
    if (gen_prim) is_generic = true;
    while (matches_binary_expr(context)) {
        let tkn = peek(&context.lexer);
        let new_prec = get_binary_precedence(tkn.data);
        if (new_prec < precedence) break;
        if (new_prec == precedence && tag(&associativity) == comptime tag(&Assoc::Left)) break;
        let new_assoc = get_binary_associativity(tkn);
        let (gen_sec, _expr) = parse_secondary_expr(context, expr, new_prec, new_assoc);
        if (gen_sec) is_generic = true;
        expr = _expr;
    }
    expr.parent = context.parent;
    return (is_generic, expr);
}

@trace func parse_primary_expr(context: &Parse_Context) -> (bool, &AST) {
    if (matches_unary_expr(context)) {
        return parse_unary_expr(context);
    }
    let tkn = next(&context.lexer);
    match (tkn.data) {
        TokenData::Dollar => {
            let TokenData::Ident { name } = expect(&context.lexer, TokenData::Ident).data else {
                unreachable("Expect");
            };
            if (context.generic_type_mapping.length > 0) {
                let hit: &&Type = getRaw(&context.generic_type_mapping, name);
                if (hit != null) {
                    return (false, create_expr(context.parent, tkn.loc, name, ASTExpr::ResolvedGeneric(*hit)));
                }
                message(todo(blank, "parse_primary_expr: Is this reachable?"));
            }
            return (true, create_expr(context.parent, tkn.loc, name, ASTExpr::Generic));
        }
        TokenData::BuiltinType { name } => {
            let expr = create_expr(context.parent, tkn.loc, name, ASTExpr::BuiltinType { name: name });
            expr.type = get_builtin_type(name);
            return (false, expr);
        }
        TokenData::Ident { name } => {
            return (false, create_expr(context.parent, tkn.loc, name, ASTExpr::Ident { name: name }));
        }
        TokenData::Number { value } => {
            return (false, create_expr(context.parent, tkn.loc, value, ASTExpr::Number { value: value }));
        }
        TokenData::StringLiteral { origin, value } => {
            return (false, create_expr(context.parent, tkn.loc, origin, ASTExpr::StringLiteral { value: value }));
        }
        TokenData::KeywordIf => {
            expect(&context.lexer, TokenData::ParenOpen);
            let (gen_cond, cond) = parse_expr(context);
            expect(&context.lexer, TokenData::ParenClose);
            let (gen_body, body) = parse_stmt(context);
            if (!is_block(body) && !is_if(body)) expect(&context.lexer, TokenData::SemiColon);
            let is_generic = gen_cond || gen_body;
            if (eat(&context.lexer, TokenData::KeywordElse)) {
                let (gen_else, elze) = parse_stmt(context);
                return (is_generic || gen_else, create_expr(context.parent, tkn.loc, blank, ASTExpr::IfElse(cond, body, elze)));
            } else {
                return (is_generic, create_expr(context.parent, tkn.loc, blank, ASTExpr::If(cond, body)));
            }
        }
        TokenData::KeywordBlank => {
            return (false, create_expr(context.parent, tkn.loc, comptime newSubStrOfStrLit("blank"), ASTExpr::Blank));
        }
        TokenData::KeywordNull => {
            return (false, create_expr(context.parent, tkn.loc, comptime newSubStrOfStrLit("null"), ASTExpr::Null));
        }
        TokenData::CurlyOpen => {
            return parse_block(context);
        }
        TokenData::Dot => {
            let name_tkn = expect(&context.lexer, TokenData::Ident);
            let TokenData::Ident { name } = name_tkn.data else { unreachable(); };
            let args = new_GAF_List(type_info(&AST));
            let is_generic = false;
            if (eat(&context.lexer, TokenData::ParenOpen)) {
                while (!lexer_at(&context.lexer, TokenData::ParenClose)) {
                    let (gen_arg, arg) = parse_expr(context);
                    if (gen_arg) is_generic = true;
                    push(&args, arg);
                }
                if (args.length == 0) {
                    message(
                        error(name_tkn.loc, "Unexpected parentheses in empty type variant initialization."),
                        note(name_tkn.loc, "Tuple variants must always have at least one field, so an initialization like .%() is always incorrect.", name)
                    );
                }
                expect(&context.lexer, TokenData::ParenClose);
            }
            return (is_generic, create_expr(context.parent, tkn.loc, name, ASTExpr::VariantInit(null, name, args)));
        }
        t => {
            message(error(tkn.loc, "Expected primary expression, but got %.", to_cstr(t)));
        }
    }
    todo_with_msg("primary");
}

@trace func parse_directive(context: &Parse_Context) -> (bool, &AST) {
    let tkn = expect(&context.lexer, TokenData::Ident);
    let TokenData::Ident { directive } = tkn.data else {
        unreachable("expected ident");
    };
    let dirs = [
        (comptime newSubStrOfStrLit("insert"), func (context: &Parse_Context, dir: Token, name: SubStr) -> (bool, &AST) {
            let old_ctx = context.insert_context;
            if (eat(&context.lexer, TokenData::Comma)) {
                let mod = expect(&context.lexer, TokenData::Ident);
                let name = get_name(&mod);
                if (equals(&name, &comptime newSubStrOfStrLit("expr"))) {
                    context.insert_context.parse_fn = parse_expr;
                } else if (equals(&name, &comptime newSubStrOfStrLit("stmt"))) {
                    context.insert_context.parse_fn = parse_stmt;
                } else {
                    message(error(mod.loc, "Unknown #insert modifier %.", name));
                }
            }
            let (gen_expr, expr) = parse_expr(context);
            let dir = create_directive(context.parent, dir.loc, name, Directive::Insert(expr, context.insert_context));
            context.insert_context = old_ctx;
            return (gen_expr, dir);
        }),
        (comptime newSubStrOfStrLit("run"), func (context: &Parse_Context, dir: Token, name: SubStr) -> (bool, &AST) {
            let (gen_expr, expr) = parse_expr(context);
            return (gen_expr, create_directive(context.parent, dir.loc, name, Directive::Run(expr)));
        }),
        (comptime newSubStrOfStrLit("assert"), func (context: &Parse_Context, dir: Token, name: SubStr) -> (bool, &AST) {
            let (gen_expr, expr) = parse_expr(context);
            let msg: String = blank;
            if (eat(&context.lexer, TokenData::Comma)) {
                let _msg = expect(&context.lexer, TokenData::StringLiteral);
                let TokenData::StringLiteral { _, value } = _msg.data else {
                    unreachable();
                };
                msg = value;
            } else {
                msg = comptime newReadonlyString("Compile time #assert failed!");
            }
            return (gen_expr, create_directive(context.parent, dir.loc, name, Directive::Assert(expr, msg)));
        }),
        (comptime newSubStrOfStrLit("bir"), func (context: &Parse_Context, dir: Token, name: SubStr) -> (bool, &AST) {
            let lexer = context.lexer;
            skip_until_matching(&context.lexer, TokenData::CurlyOpen, TokenData::CurlyClose);
            return (false, create_directive(context.parent, dir.loc, name, Directive::Bir(lexer)));
        }),
        (comptime newSubStrOfStrLit("debug"), func (context: &Parse_Context, dir: Token, name: SubStr) -> (bool, &AST) {
            return (false, create_directive(context.parent, dir.loc, name, Directive::Debug));
        }),
    ];
    for (let i: usize = 0; i < dirs.length; i = i + 1) {
        if (equals(&directive, &dirs[i].0)) {
            return dirs[i].1(context, tkn, directive);
        }
    }
    message(error(tkn.loc, "Use of unknown directive `%`.", directive));
    unreachable("parse_directive"); // error terminates
}

@trace func parse_unary_expr(context: &Parse_Context) -> (bool, &AST) {
    let tkn = next(&context.lexer);
    let un: ASTUnary = ASTUnary::LogicalNot;

    let old_parent = context.parent;
    let unary = context.parent = create_expr(context.parent, tkn.loc, blank, ASTExpr::Unary); // dummy node

    let precedence = get_unary_precedence(tkn.data);

    let is_generic = false;
    match (tkn.data) {
        TokenData::Hash => {
            let (gen, dir) = parse_directive(context);
            is_generic = gen;
            unary.data = ASTData::Expr(ASTExpr::Directive(dir));
        }
        TokenData::AmpersandSingle => {
            let (gen, sub) = __parse_expr(context, precedence, Assoc::Left);
            is_generic = gen;
            unary.data = ASTData::Expr(ASTExpr::Unary(ASTUnary::AddressOf(sub)));
        }
        TokenData::AsteriskSingle => {
            let (gen, sub) = __parse_expr(context, precedence, Assoc::Left);
            is_generic = gen;
            unary.data = ASTData::Expr(ASTExpr::Unary(ASTUnary::ValueOf(sub)));
        }
        TokenData::Bang => {
            let (gen, sub) = __parse_expr(context, precedence, Assoc::Left);
            is_generic = gen;
            unary.data = ASTData::Expr(ASTExpr::Unary(ASTUnary::LogicalNot(sub)));
        }
        t => {
            message(todo(tkn.loc, "parse_unary_expr: %", to_cstr(t)));
        }
    }
    context.parent = old_parent;
    return (is_generic, unary);
}

@trace func parse_secondary_expr(context: &Parse_Context, lhs: &AST, prec: usize, assoc: Assoc) -> (bool, &AST) {
    let lexer = &context.lexer;
    let op = next(lexer);
    if let TokenData::KeywordAs = op.data {
        let (generic, typ) = parse_type(context);
        return (generic, create_expr(context.parent, op.loc, blank, ASTExpr::As(lhs, typ)));
    }
    if let TokenData::Dot = op.data {
        if (!lexer_at(&context.lexer, TokenData::Ident, TokenData::Number)) {
            message(error(op.loc, "Expected identifier or number after the dot operator, but got %.", to_cstr(next(&context.lexer).data)));
        }
        let (false, member) = parse_primary_expr(context) else {
            unreachable("Can't be generic because it's ident or number");
        };
        return (false, create_expr(context.parent, op.loc, blank, ASTExpr::Dot(lhs, member)));
    }
    if let TokenData::ParenOpen = op.data {
        let args = new_GAF_List(type_info(&AST));
        let is_generic = false;
        let old_parent = context.parent;
        let call_expr = lhs.parent = context.parent = create_expr(context.parent, op.loc, blank, ASTExpr::Call);
        while (!lexer_at(&context.lexer, TokenData::ParenClose)) {
            let (gen_expr, _expr) = parse_expr(context);
            if (gen_expr) is_generic = gen_expr;
            push(&args, _expr);
            if (!lexer_at(&context.lexer, TokenData::ParenClose)) {
                expect(&context.lexer, TokenData::Comma);
            }
        }
        let end = expect(&context.lexer, TokenData::ParenClose);
        context.parent = old_parent;
        call_expr.data = ASTData::Expr(ASTExpr::Call(lhs, args));
        return (is_generic, call_expr);
    }

    let (generic, rhs) = __parse_expr(context, prec, assoc);
    return (generic, create_expr(context.parent, op.loc, blank, binary_expr_from_op(op, lhs, rhs)));
}

