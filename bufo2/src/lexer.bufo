
import "prelude.bufo";
import "libc.bufo";
import "type_info.bufo";
import "string.bufo";
import "substr.bufo";
import "format.bufo";

import "common.bufo";
import "corot.bufo";
import "type.bufo";

struct Token {
    loc: Loc;
    data: TokenData;
}

union TokenData {
    Empty,
    BuiltinType { name: SubStr },
    Ident { name: SubStr },
    Number { value: SubStr },
    StringLiteral { origin: SubStr, value: String },

    KeywordModule,
    KeywordFunc,
    KeywordType,
    KeywordStruct,
    KeywordUnion,
    KeywordLet,
    KeywordComptime,
    KeywordIf,
    KeywordElse,
    KeywordReturn,
    KeywordBlank,
    KeywordNull,
    KeywordAs,

    ParenOpen,
    ParenClose,
    CurlyOpen,
    CurlyClose,
    SquareOpen,
    SquareClose,
    ColonSingle,
    Comma,
    SemiColon,
    Dollar,
    AsteriskSingle,
    AmpersandSingle,
    MinusSingle,
    PlusSingle,
    Dot,
    Bang,
    NotEqual,
    EqualSingle,
    EqualDouble,
    AmpersandDouble,
    Hash,
    At,
    SlashSingle,

    LessThan,
    LessEqual,
    GreaterThan,
    GreaterEqual,

    PlusEqual,
    MinusEqual,
    AsteriskEqual,
    SlashEqual,

    Arrow,

    EndOfFile,
}

func to_cstr(t: TokenData) -> &char {
    (comptime assert(tag(&TokenData::EndOfFile) == 50, "TokenData::to_cstr: Added more tokens"));
    return [
        "<empty token>",
        "builtin type",
        "identifier",
        "number",
        "string literal",

        "`module`",
        "`func`",
        "`type`",
        "`struct`",
        "`union`",
        "`let`",
        "`comptime`",
        "`if`",
        "`else`",
        "`return`",
        "`blank`",
        "`null`",
        "`as`",

        "`(`",
        "`)`",
        "`{`",
        "`}`",
        "`[`",
        "`]`",
        "`:`",
        "`,`",
        "`;`",
        "`$`",
        "`*`",
        "`&`",
        "`-`",
        "`+`",
        "`.`",
        "`!`",
        "`!=`",
        "`=`",
        "`==`",
        "`&&`",
        "`#`",
        "`@`",
        "`/`",

        "`<`",
        "`<=`",
        "`>`",
        "`>=`",

        "`+=`",
        "`-=`",
        "`*=`",
        "`/=`",

        "`->`",

        "<end of file>",
    ][tag(&t) as usize];
}

func get_name(t: &Token) -> SubStr {
    match (&t.data) {
        &TokenData::Ident { name } => { return name; }
        _ => { todo_with_msg("get_name(Token)"); }
    }
    unreachable("get_name()");
}

func is_keyword(s: SubStr, kw: &TokenData) -> bool {
    (comptime assert(tag(&TokenData::EndOfFile) == 50, "Lexer::is_keyword: Added more tokens"));
    if (s.len < 2 || s.len > 8) return false;

    let first = s.start[0];
    let len = s.len;
    if (first == 'a' && len == 2) {
        if (equals(&s, &comptime newSubStrOfStrLit("as"))) {
            *kw = TokenData::KeywordAs;
            return true;
        }
    } else if (first == 'b' && len == 5) {
        if (equals(&s, &comptime newSubStrOfStrLit("blank"))) {
            *kw = TokenData::KeywordBlank;
            return true;
        }
    } else if (first == 'c' && len == 8) {
        if (equals(&s, &comptime newSubStrOfStrLit("comptime"))) {
            *kw = TokenData::KeywordComptime;
            return true;
        }
    } else if (first == 'e' && len == 4) {
        if (equals(&s, &comptime newSubStrOfStrLit("else"))) {
            *kw = TokenData::KeywordElse;
            return true;
        }
    } else if (first == 'f' && len == 4) {
        if (equals(&s, &comptime newSubStrOfStrLit("func"))) {
            *kw = TokenData::KeywordFunc;
            return true;
        }
    } else if (first == 'i' && len == 2) {
        if (equals(&s, &comptime newSubStrOfStrLit("if"))) {
            *kw = TokenData::KeywordIf;
            return true;
        }
    } else if (first == 'l' && len == 3) {
        if (equals(&s, &comptime newSubStrOfStrLit("let"))) {
            *kw = TokenData::KeywordLet;
            return true;
        }
    } else if (first == 'm' && len == 6) {
        if (equals(&s, &comptime newSubStrOfStrLit("module"))) {
            *kw = TokenData::KeywordModule;
            return true;
        }
    } else if (first == 'n' && len == 4) {
        if (equals(&s, &comptime newSubStrOfStrLit("null"))) {
            *kw = TokenData::KeywordNull;
            return true;
        }
    } else if (first == 'r' && len == 6) {
        if (equals(&s, &comptime newSubStrOfStrLit("return"))) {
            *kw = TokenData::KeywordReturn;
            return true;
        }
    } else if (first == 's' && len == 6) {
        if (equals(&s, &comptime newSubStrOfStrLit("struct"))) {
            *kw = TokenData::KeywordStruct;
            return true;
        }
    } else if (first == 't' && len == 4) {
        if (equals(&s, &comptime newSubStrOfStrLit("type"))) {
            *kw = TokenData::KeywordType;
            return true;
        }
    } else if (first == 'u' && len == 5) {
        if (equals(&s, &comptime newSubStrOfStrLit("union"))) {
            *kw = TokenData::KeywordUnion;
            return true;
        }
    }
    return false;
}

func is_builtin_type(s: SubStr) -> bool {
    (comptime assert(tag(&TokenData::EndOfFile) == 50, "Lexer::is_builtin_type: Added more tokens"));
    comptime types = [
        newSubStrOfStrLit("i8"),
        newSubStrOfStrLit("i16"),
        newSubStrOfStrLit("i32"),
        newSubStrOfStrLit("i64"),
        newSubStrOfStrLit("u8"),
        newSubStrOfStrLit("u16"),
        newSubStrOfStrLit("u32"),
        newSubStrOfStrLit("u64"),
        newSubStrOfStrLit("usize"),
        newSubStrOfStrLit("bool"),
        newSubStrOfStrLit("str"),
        newSubStrOfStrLit("none"),
    ];
    (comptime assert(types.length == tag(&PrimType::__count) as usize, "Lexer::is_builtin_type: Added primitive type"));
    for (let i: usize = 0; i < types.length; i = i + 1) {
        if (equals(&s, &types[i])) {
            return true;
        }
    }
    return false;
}

struct Lexer {
    file_name: SubStr;
    offset_in_file: usize;
    source: SubStr;
}

func is_empty(l: &Lexer) -> bool {
    return l.source.len == 0;
}

func __next(l: &Lexer) -> Token {
    while (true) {
        let (tkn, is_comment) = __next2(l);
        if (!is_comment) return tkn;
    }
    unreachable("__next");
}

func __next2(l: &Lexer) -> (Token, bool) {
    let advance = func (s: &SubStr, bytes: usize, offset_in_file: &usize) {
        assert(bytes <= s.len, "lexer: advance beyond EOF");
        s.start = s.start + bytes;
        s.len = s.len - bytes;
        *offset_in_file = *offset_in_file + bytes;
    };
    let tkn: Token = Token {
        loc: new_loc(l.file_name, l.offset_in_file),
        data: TokenData::EndOfFile
    };
    if (l.source.len == 0) return (tkn, false);

    let first = l.source.start[0];
    while (isWhitespace(first)) {
        advance(&l.source, 1, &l.offset_in_file);
        first = l.source.start[0];
    }
    tkn.loc.offset = l.offset_in_file;
    if (l.source.len == 0) return (tkn, false);

    let offset = l.offset_in_file;
    let i: usize = 1;
    (comptime assert(tag(&TokenData::EndOfFile) == 50, "Lexer::__next2: Added more tokens"));
    if (isAlphabetic(first) || first == '_') {
        while (isAlphanumeric(l.source.start[i]) || l.source.start[i] == '_') i = i + 1;
        let kw: TokenData = TokenData::Empty;
        let name = substring(&l.source, 0, i);
        if (is_keyword(name, &kw)) {
            tkn.data = kw;
        } else if (is_builtin_type(name)) {
            tkn.data = TokenData::BuiltinType { name: name };
        } else {
            tkn.data = TokenData::Ident { name: name };
        }
    } else if (isNumeric(first)) {
        while (isNumeric(l.source.start[i]) || l.source.start[i] == '_') i = i + 1;
        tkn.data = TokenData::Number { value: substring(&l.source, 0, i) };
    } else if (first == '"') {
        let ch = l.source.start[i];
        let escaped = false;
        let s: String = blank;
        while (i < l.source.len && ch != '"') {
            if (escaped) {
                if (ch == '\\') {
                    pushChar(&s, '\\');
                } else if (ch == 'n') {
                    pushChar(&s, '\n');
                } else {
                    message(error(new_loc(l.file_name, l.offset_in_file + i), "Can't escape character `%`.", ch));
                }
                escaped = false;
            } else if (ch == '\\') {
                escaped = true;
            } else {
                pushChar(&s, ch);
            }
            i = i + 1;
            ch = l.source.start[i];
        }
        if (ch != '"') message(error(new_loc(l.file_name, l.offset_in_file), "Unescaped string literal"));
        i = i + 1; // closing quote
        tkn.data = TokenData::StringLiteral { origin: substring(&l.source, 0, i), value: s };
    } else if (first == '(') {
        tkn.data = TokenData::ParenOpen;
    } else if (first == ')') {
        tkn.data = TokenData::ParenClose;
    } else if (first == '{') {
        tkn.data = TokenData::CurlyOpen;
    } else if (first == '}') {
        tkn.data = TokenData::CurlyClose;
    } else if (first == '[') {
        tkn.data = TokenData::SquareOpen;
    } else if (first == ']') {
        tkn.data = TokenData::SquareClose;
    } else if (first == ':') {
        tkn.data = TokenData::ColonSingle;
    } else if (first == ',') {
        tkn.data = TokenData::Comma;
    } else if (first == ';') {
        tkn.data = TokenData::SemiColon;
    } else if (first == '$') {
        tkn.data = TokenData::Dollar;
    } else if (first == '*') {
        tkn.data = TokenData::AsteriskSingle;
    } else if (first == '&') {
        if (l.source.len > 1 && l.source.start[1] == '&') {
            tkn.data = TokenData::AmpersandDouble;
            i = 2;
        } else {
            tkn.data = TokenData::AmpersandSingle;
        }
    } else if (first == '+') {
        if (l.source.len > 1 && l.source.start[1] == '=') {
            tkn.data = TokenData::PlusEqual;
            i = 2;
        } else {
            tkn.data = TokenData::PlusSingle;
        }
    } else if (first == '-') {
        if (l.source.len > 1 && l.source.start[1] == '>') {
            tkn.data = TokenData::Arrow;
            i = 2;
        } else if (l.source.len > 1 && l.source.start[1] == '=') {
            tkn.data = TokenData::MinusEqual;
            i = 2;
        } else {
            tkn.data = TokenData::MinusSingle;
        }
    } else if (first == '.') {
        tkn.data = TokenData::Dot;
    } else if (first == '!') {
        if (l.source.len > 1 && l.source.start[1] == '=') {
            tkn.data = TokenData::NotEqual;
            i = 2;
        } else {
            tkn.data = TokenData::Bang;
        }
    } else if (first == '=') {
        if (l.source.len > 1 && l.source.start[1] == '=') {
            tkn.data = TokenData::EqualDouble;
            i = 2;
        } else {
            tkn.data = TokenData::EqualSingle;
        }
    } else if (first == '<') {
        if (l.source.len > 1 && l.source.start[1] == '=') {
            tkn.data = TokenData::LessEqual;
            i = 2;
        } else {
            tkn.data = TokenData::LessThan;
        }
    } else if (first == '>') {
        if (l.source.len > 1 && l.source.start[1] == '=') {
            tkn.data = TokenData::GreaterEqual;
            i = 2;
        } else {
            tkn.data = TokenData::GreaterThan;
        }
    } else if (first == '#') {
        tkn.data = TokenData::Hash;
    } else if (first == '@') {
        tkn.data = TokenData::At;
    } else if (first == '/') {
        if (l.source.len > 1 && l.source.start[1] == '*') {
            // /*
            while (true) {
                advance(&l.source, 1, &l.offset_in_file);
                first = l.source.start[0];
                if (l.source.len == 0) return (Token { loc: tkn.loc, data: TokenData::EndOfFile }, false);
                let next = l.source.start[1];
                if (first == '*' && next == '/') {
                    break;
                }
            }
            advance(&l.source, 2, &l.offset_in_file); // */
            return (blank, true);
        } else if (l.source.len > 1 && l.source.start[1] == '/') {
            while (first != '\n') {
                advance(&l.source, 1, &l.offset_in_file);
                first = l.source.start[0];
            }
            advance(&l.source, 1, &l.offset_in_file); // Linebreak
            return (blank, true);
        } else if (l.source.len > 1 && l.source.start[1] == '=') {
            tkn.data = TokenData::SlashEqual;
            i = 2;
        } else {
            tkn.data = TokenData::SlashSingle;
        }
    } else {
        message(error(new_loc(l.file_name, l.offset_in_file), "Unknown character `%`.", first));
    }
    tkn.loc = new_loc(l.file_name, offset);
    advance(&l.source, i, &l.offset_in_file);
    return (tkn, false);
}

func peek(l: &Lexer) -> Token {
    let _l = *l;
    let tkn = __next(&_l);
    return tkn;
}

func next(l: &Lexer) -> Token {
    return __next(l);
}

func lexer_at(l: &Lexer, token: ...TokenData) -> bool {
    let tkn = peek(l);
    for (let i: usize = 0; i < token.length; i = i + 1) {
        if (tag(&tkn.data) == tag(&token[i])) {
            return true;
        }
    }
    return false;
}

func eat(l: &Lexer, token: TokenData) -> bool {
    if (!lexer_at(l, token)) return false;
    next(l);
    return true;
}

func expect(l: &Lexer, tokens: ...TokenData) -> Token {
    let tkn = next(l);
    for (let i: usize = 0; i < tokens.length; i = i + 1) {
        if (tag(&tkn.data) == tag(&tokens[i])) return tkn;
    }
    let out = String {};
    format(&out, "Expected ");
    if (tokens.length > 1) format(&out, "one of ");
    for (let i: usize = 0; i < tokens.length; i = i + 1) {
        format(&out, "%", to_cstr(tokens[i]));
        if (tokens.length > 2 && i < tokens.length - 2) format(&out, ", ");
        else if (i == tokens.length - 2) format(&out, " or ");
    }
    format(&out, ", but got %.", to_cstr(tkn.data));
    message(error(tkn.loc, "%", out));
    return blank; // normally unreachable, except for skip_until_matching
}

func skip_until(l: &Lexer, token: TokenData) -> Token {
    while (!lexer_at(l, token)) {
        next(l);
    }
    return expect(l, token);
}

func skip_until_matching(lexer: &Lexer, start: TokenData, end: TokenData) -> Token {
    let tok = expect(lexer, start);
    let count: usize = 1;
    while (count != 0) {
        let tkn = next(lexer);
        if (tag(&tkn.data) == tag(&TokenData::EndOfFile)) {
            suppress_exit_on_error();
            expect(lexer, end);
            message(note(tok.loc, "...while trying to match this %.", to_cstr(start)));
            message(finalize_error());
        }
        if (tag(&tkn.data) == tag(&start)) {
            count = count + 1;
        } else if (tag(&tkn.data) == tag(&end)) {
            count = count - 1;
            if (count == 0) return tkn;
        }
    }
    unreachable("Should've returned by now");
}
