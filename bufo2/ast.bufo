struct FunctionState {
    is_generic: bool;
    is_monomorphized: bool;
    did_parse_signature: bool;
    did_check_signature: bool;
    did_parse_body: bool;
    did_check_body: bool;
    did_codegen_body: bool;
}

struct StructState {
    is_monomorphized: bool;
    did_parse_signature: bool;
    did_parse_fields: bool;
    did_check_fields: bool;
}

func create_mapping_key(out: &String, mapping: &GAF_HashMap) {
    for (let i: usize = 0; i < mapping.capacity; i = i + 1) {
        if (!mapping.set_elements[i]) continue;
        let (key_ptr, val_ptr) = getAtIndex(mapping, i);
        let type = *(val_ptr as &&Type);
        to_string(out, type);
    }
}

struct AST {
    super_node: &AST; // Function, Struct or the like
    parent: &AST;     // Expr can be parent of Expr
    origin: SubStr;
    loc: Loc;
    attributes: GAF_List; // List<ASTAttr>
    type: &Type;
    data: ASTData;
}

func has_attribute(node: &AST, attr: ASTAttrData) -> bool {
    for (let i: usize = 0; i < node.attributes.length; i = i + 1) {
        let a = get_ref(&node.attributes, i) as ASTAttr;
        if (tag(&a.data) == tag(&attr)) {
            return true;
        }
    }
    return false;
}

func is_in_function(node: &AST) -> bool {
    if let ASTData::Function { .. } = node.super_node.data {
        return true;
    }
    return false;
}
func get_parent_function(node: &AST) -> &AST {
    if let ASTData::Function { .. } = node.super_node.data {
        return node.super_node;
    }
    unreachable("get_parent_function: Node is not inside a function");
}

func is_assignment(node: &AST) -> bool {
    let ASTData::Expr(ASTExpr::Binary(bin)) = node.data else {
        return false;
    };
    return is_assignment(bin);
}
func is_statement(node: &AST) -> bool {
    if let ASTData::Stmt(_) = node.data {
        return true;
    }
    return false;
}
func is_if(node: &AST) -> bool {
    if let ASTData::Stmt(ASTStmt::Expr(expr)) = node.data {
        return is_if(expr);
    }
    if let ASTData::Expr(ASTExpr::If(_, _)) = node.data {
        return true;
    }
    if let ASTData::Expr(ASTExpr::IfElse(_, _, _)) = node.data {
        return true;
    }
    return false;
}
func is_block(node: &AST) -> bool {
    if let ASTData::Stmt(ASTStmt::Expr(expr)) = node.data {
        return is_block(expr);
    }
    if let ASTData::Expr(ASTExpr::BlockVoid(_)) = node.data {
        return true;
    }
    if let ASTData::Expr(ASTExpr::BlockExpr(_, _)) = node.data {
        return true;
    }
    return false;
}

union ASTData {
    Struct(ASTStruct),
    Field(SubStr, &AST),
    Function(ASTFunction),
    Stmt(ASTStmt),
    Expr(ASTExpr),
    Pat(ASTPat),
    Param(&AST),
    Directive(Directive),
}

struct ASTStruct {
    state: StructState;
    loc: Loc;
    name: SubStr;
    parameters: GAF_List; // List<&AST>
    fields: GAF_List; // List<&AST>
    monomorphized_instances: GAF_HashMap; // HashMap<String, &AST>
    size_in_bytes: usize;
    align_in_bytes: usize;
}

func is_generic(struct_info: &ASTStruct) -> bool {
    let (handler, state) = wait_for_monitor(&struct_info.state.did_parse_signature);
    let Corot_Result::Success = state else {
        handle_corot_result(state,
            error(struct_info.loc, "Could not check if structure is generic due to a cyclic dependency on %.", corot_str(handler)),
            error(struct_info.loc, "Could not check if structure is generic. There were errors."));
        unreachable(); // above terminates
    };
    assert(struct_info.state.did_parse_signature, "is_generic(Struct): monitor failed");
    return struct_info.parameters.length != 0;
}

func get_field_offset_size_and_align(struct_info: &ASTStruct, name: SubStr) -> (bool, usize, usize, usize) {
    let offset: usize = 0;
    let size: usize = 0;
    let align: usize = 1;
    for (let i: usize = 0; i < struct_info.fields.length; i = i + 1) {
        let field = get_ref(&struct_info.fields, i) as &AST;
        let &ASTData::Field(field_name, _) = &field.data else {
            unreachable("get_field_offset: Stored entry is not a Field!");
        };
        let field_type = unwrap_meta_type(field.type, 1);
        let field_size = get_size(field_type);
        if (equals(&field_name, &name)) {
            let field_align = get_align(field_type);
            return (true, offset, field_size, field_align);
        } else if (i != struct_info.fields.length - 1) {
            let next_field = get_ref(&struct_info.fields, i + 1) as &AST;
            let next_field_type = unwrap_meta_type(next_field.type, 1);
            let next_field_align = get_align(next_field_type);
            offset = next_multiple_of(offset + field_size, next_field_align);
        }
    }
    return (false, 0, 0, 0);
}

func get_field_by_name(struct_info: &ASTStruct, name: SubStr) -> (bool, &AST) {
    for (let i: usize = 0; i < struct_info.fields.length; i = i + 1) {
        let field = get_ref(&struct_info.fields, i) as &AST;
        let &ASTData::Field(field_name, field_type) = &field.data else {
            unreachable("get_field_by_name: Stored entry is not a Field!");
        };
        if (equals(&field_name, &name)) {
            return (true, field);
        }
    }
    return (false, null);
}

func get_align(node: &AST) -> usize {
    let struct_info = get_struct_info(node);
    let (handler, result) = wait_for_monitor(&struct_info.align_in_bytes);
    let Corot_Result::Success = result else {
        handle_corot_result(result,
            error(node.loc, "Could not get alignment of structure due to a cyclic dependency on %.", corot_str(handler)),
            error(node.loc, "Could not get alignment of structure. There were errors."));
        unreachable(); // above terminates
    };
    return struct_info.align_in_bytes;
}

func get_size(node: &AST) -> usize {
    let struct_info = get_struct_info(node);
    let (handler, result) = wait_for_monitor(&struct_info.size_in_bytes);
    let Corot_Result::Success = result else {
        handle_corot_result(result,
            error(node.loc, "Could not get size of structure due to a cyclic dependency on %.", corot_str(handler)),
            error(node.loc, "Could not get size of structure. There were errors."));
        unreachable(); // above terminates
    };
    return struct_info.size_in_bytes;
}

func add_field(parent: &AST, struct_info: &ASTStruct, loc: Loc, name: SubStr, type: &AST) {
    let field = create_node(parent, loc, name);
    field.data = ASTData::Field(name, type);
    push(&struct_info.fields, field);
}

func get_struct_info(fn: &AST) -> &ASTStruct {
    let &ASTData::Struct(struct_info) = &fn.data else {
        unreachable("get_struct_info: Node is not a struct");
    };
    return &struct_info;
}
func get_func_info(fn: &AST) -> &ASTFunction {
    let &ASTData::Function(func_info) = &fn.data else {
        unreachable("get_func_info: Node is not a function");
    };
    return &func_info;
}

struct ASTFunction {
    state: FunctionState;
    loc: Loc;
    name: SubStr;
    scopes: GAF_List;     // List<Scope_Info>
    return_type: &AST;
    params: GAF_List;     // List<&AST>
    block: &AST;
    code: Code;
    monomorphized_instances: GAF_HashMap; // HashMap<String, &AST>
}

func is_generic(func_info: &ASTFunction) -> bool {
    let (handler, state) = wait_for_monitor(&func_info.state.did_parse_signature);
    let Corot_Result::Success = state else {
        handle_corot_result(state,
            error(func_info.loc, "Could not check if function is generic due to a cyclic dependency on %.", corot_str(handler)),
            error(func_info.loc, "Could not check if function is generic. There were errors."));
        unreachable(); // above terminates
    };
    assert(func_info.state.did_parse_signature, "is_generic(Function): monitor failed");
    return func_info.state.is_generic;
}

func finalize_function_type(ast: &AST, func_info: &ASTFunction) {
    assert(ast.type == null, "finalize_function_type: Node already has a type");
    assert(func_info.state.did_check_signature, "finalize_function_type: Function signature is not type checked");

    let params = new_GAF_List(type_info(&Type));
    for (let i: usize = 0; i < func_info.params.length; i = i + 1) {
        let p = get_ref(&func_info.params, i) as &AST;
        assert(p.type != null, "finalize_function_type: Param type is null");
        push(&params, p.type);
    }

    let ret_type = func_info.return_type.type;
    assert(ret_type != null, "finalize_function_type: Return type is null");

    ast.type = create_base_type(BaseType::Func(params, ret_type));
    unregister_monitor(&ast.type, Corot_Result::Success);
}

struct ASTAttr {
    name: SubStr;
    loc: Loc;
    data: ASTAttrData;
}
func is_function_attribute(attr: ASTAttr) -> bool {
    return is_function_attribute(attr.data);
}
union ASTAttrData {
    Expand,
    Naked,
    __count,
}
func is_function_attribute(attr: ASTAttrData) -> bool {
    (comptime assert(tag(&ASTAttrData::__count) == 2, "is_function_attribute: Added more ASTAttrData"));
    match (attr) {
        ASTAttrData::Expand => { return true; }
        ASTAttrData::Naked  => { return true; }
        _ => { }
    }
    return false;
}

union ASTStmt {
    Directive(&AST),
    Expr(&AST),
    ReturnExpr(&AST),
    ReturnVoid,
    Let {
        pat: &AST,
        expr: &AST,       // if null: let <pat>;
        trampoline: &AST, // if null: let <pat> = <expr>;
    },
    Comptime {
        pat: &AST,
        expr: &AST,       // if null: let <pat>;
        trampoline: &AST, // if null: let <pat> = <expr>;
    },
}

union ASTPat {
    Ident(SubStr),
    PatWithType(&AST, &AST), // SubPattern, Type
}

union ASTExpr {
    Noop, // See FIXME for union Directive
    BuiltinType { name: SubStr },
    Ident { name: SubStr },
    FnIdent { name: SubStr, fn: &AST },
    Number { value: SubStr },
    StringLiteral { value: String },
    Call(&AST, GAF_List), // arguments = List<&AST>
    // if (<cond>) <then>
    If(&AST, &AST),
    // if (<cond>) <then> else <else>
    IfElse(&AST, &AST, &AST),
    // BlockExpr is something like `{ let a = 12; a }` and returns a non-none value
    BlockExpr(GAF_List, &AST), // List<&AST>
    BlockVoid(GAF_List), // List<&AST>
    Unary(ASTUnary),
    Binary(ASTBinary),
    Blank,
    Null,
    Directive(&AST),
    ComptimeValue(Value),
    Generic,
    ResolvedGeneric(&Type),
    As(&AST, &AST),
    Dot(&AST, &AST),
}

func get_statements(node: &ASTExpr) -> &GAF_List {
    if let &ASTExpr::BlockVoid(stmts) = node {
        return &stmts;
    }
    if let &ASTExpr::BlockExpr(stmts, _) = node {
        return &stmts;
    }
    unreachable("get_statements: Node is not a block");
}

union Directive {
    Run(&AST),
    Insert(&AST, Insert_Context),
    Assert(&AST, String),
    // FIXME(2026-06-05): Ideally we dont wanna have a CheckedBir,
    //                    but the code around #bir is kinda sloppy rn
    Bir(Lexer),
    CheckedBir(Lexer, GAF_List), // List<Type>
    Debug,
}

union ASTUnary {
    LogicalNot(&AST),
    AddressOf(&AST),
    ValueOf(&AST),
}

union ASTBinary {
    Assign(&AST, &AST),
    PlusAssign(&AST, &AST),
    MinusAssign(&AST, &AST),
    MultAssign(&AST, &AST),
    DivAssign(&AST, &AST),
    Equal(&AST, &AST),
    Plus(&AST, &AST),
    Minus(&AST, &AST),
    Mult(&AST, &AST),
    Div(&AST, &AST),
    LessThan(&AST, &AST),
    LessEqual(&AST, &AST),
    GreaterThan(&AST, &AST),
    GreaterEqual(&AST, &AST),
    __count,
}

func is_assignment(bin: ASTBinary) -> bool {
    (comptime assert(tag(&ASTBinary::__count) == 14, "is_assignment: Added more Operands"));
    match (bin) {
        ASTBinary::Assign(..)      => { return true; }
        ASTBinary::PlusAssign(..)  => { return true; }
        ASTBinary::MinusAssign(..) => { return true; }
        ASTBinary::MultAssign(..)  => { return true; }
        ASTBinary::DivAssign(..)   => { return true; }
        _ => { }
    }
    return false;
}

func binary_expr_to_function_name(bin: ASTBinary) -> SubStr {
    (comptime assert(tag(&ASTBinary::__count) == 14, "binary_expr_to_function_name: Added more Operands"));
    match (bin) {
        ASTBinary::Assign(..)       => { return comptime newSubStrOfStrLit("__assign__"); }
        ASTBinary::PlusAssign(..)   => { return comptime newSubStrOfStrLit("__plus_assign__"); }
        ASTBinary::MinusAssign(..)  => { return comptime newSubStrOfStrLit("__minus_assign__"); }
        ASTBinary::MultAssign(..)   => { return comptime newSubStrOfStrLit("__mult_assign__"); }
        ASTBinary::DivAssign(..)    => { return comptime newSubStrOfStrLit("__div_assign__"); }
        ASTBinary::Equal(..)        => { return comptime newSubStrOfStrLit("__equals__"); }
        ASTBinary::Plus(..)         => { return comptime newSubStrOfStrLit("__add__"); }
        ASTBinary::Minus(..)        => { return comptime newSubStrOfStrLit("__sub__"); }
        ASTBinary::Mult(..)         => { return comptime newSubStrOfStrLit("__mul__"); }
        ASTBinary::Div(..)          => { return comptime newSubStrOfStrLit("__div__"); }
        ASTBinary::LessThan(..)     => { return comptime newSubStrOfStrLit("__lt__"); }
        ASTBinary::LessEqual(..)    => { return comptime newSubStrOfStrLit("__lte__"); }
        ASTBinary::GreaterThan(..)  => { return comptime newSubStrOfStrLit("__gt__"); }
        ASTBinary::GreaterEqual(..) => { return comptime newSubStrOfStrLit("__gte__"); }
        _ => { }
    }
    unreachable("binary_expr_to_function_name");
}

func binary_expr_from_op(op: Token, lhs: &AST, rhs: &AST) -> ASTExpr {
    (comptime assert(tag(&ASTBinary::__count) == 14, "binary_expr_from_op: Added more Operands"));
    let bin = ASTBinary::Equal;
    match (op.data) {
        TokenData::EqualSingle    => { bin = ASTBinary::Assign(lhs, rhs); }
        TokenData::PlusEqual      => { bin = ASTBinary::PlusAssign(lhs, rhs); }
        TokenData::MinusEqual     => { bin = ASTBinary::MinusAssign(lhs, rhs); }
        TokenData::AsteriskEqual  => { bin = ASTBinary::MultAssign(lhs, rhs); }
        TokenData::SlashEqual     => { bin = ASTBinary::DivAssign(lhs, rhs); }
        TokenData::EqualDouble    => { bin = ASTBinary::Equal(lhs, rhs); }
        TokenData::PlusSingle     => { bin = ASTBinary::Plus(lhs, rhs); }
        TokenData::MinusSingle    => { bin = ASTBinary::Minus(lhs, rhs); }
        TokenData::AsteriskSingle => { bin = ASTBinary::Mult(lhs, rhs); }
        TokenData::SlashSingle    => { bin = ASTBinary::Div(lhs, rhs); }
        TokenData::LessThan       => { bin = ASTBinary::LessThan(lhs, rhs); }
        TokenData::LessEqual      => { bin = ASTBinary::LessEqual(lhs, rhs); }
        TokenData::GreaterThan    => { bin = ASTBinary::GreaterThan(lhs, rhs); }
        TokenData::GreaterEqual   => { bin = ASTBinary::GreaterEqual(lhs, rhs); }
        _ => { }
    }
    return ASTExpr::Binary(bin);
}

func extract_operands(bin: ASTBinary, lhs: &&AST, rhs: &&AST) {
    (comptime assert(tag(&ASTBinary::__count) == 14, "extract_operands: Added more Operands"));
    match (bin) {
        ASTBinary::Assign      (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::PlusAssign  (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::MinusAssign (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::MultAssign  (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::DivAssign   (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::Equal       (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::Plus        (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::Minus       (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::Mult        (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::Div         (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::LessThan    (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::LessEqual   (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::GreaterThan (_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        ASTBinary::GreaterEqual(_lhs, _rhs) => { *lhs = _lhs; *rhs = _rhs; }
        _ => { unreachable("extract_operands"); }
    }
}

comptime AST_BUFFER_SIZE: usize = 1_000_000;
let ast_buffer_ptr: &AST = null;
let ast_buffer_base: &AST = null;

let node_counter: usize = 0;
@trace func create_node(parent: &AST, loc: Loc, origin: SubStr) -> &AST {
    if (ast_buffer_ptr == null) {
        ast_buffer_ptr = C::calloc(AST_BUFFER_SIZE, sizeof(AST));
        ast_buffer_base = ast_buffer_ptr;
    }
    if (ast_buffer_ptr - ast_buffer_base >= AST_BUFFER_SIZE * sizeof(AST)) {
        ast_buffer_ptr = C::calloc(AST_BUFFER_SIZE, sizeof(AST));
        ast_buffer_base = ast_buffer_ptr;
    }
    let ptr = ast_buffer_ptr as &AST;
    ast_buffer_ptr = ast_buffer_ptr + sizeof(AST);
    if (parent != null) {
        fassert(parent.super_node != null, "Parent at % doesn't belong to a super node", loc);
        ptr.super_node = parent.super_node;
    }
    ptr.parent = parent;
    ptr.origin = origin;
    ptr.loc = loc;
    return ptr;
}

@trace func create_struct(parent: &AST, loc: Loc, origin: SubStr, name: SubStr) -> &AST {
    let ptr = create_node(parent, loc, origin);
    ptr.data = ASTData::Struct(ASTStruct {
        state: blank,
        loc: loc,
        name: name,
        fields: new_GAF_List(type_info(&AST)),
        parameters: new_GAF_List(type_info(&AST)),
        monomorphized_instances: new_hashmap_with_string_key(type_info(&AST)),
    });
    let lookup = get_struct_by_name(&global_lookup, name);
    if (lookup != null) {
        message(
            error(loc, "Redeclaration of type %.", name),
            note(lookup.node.loc, "Type already declared here."),
        );
    }
    add(&global_lookup.structs, name, new_struct_lookup(ptr));
    return ptr;
}

func monomorphize_function_node(ast: &AST, mapping: GAF_HashMap) -> &AST {
    let &ASTData::Function(parent) = &ast.data else { unreachable(); };

    let key: String = blank;
    create_mapping_key(&key, &mapping);

    // We've already monomorphized this mapping, we don't need to do any further work
    let child = get(&parent.monomorphized_instances, key);
    if (child.ptr != null) {
        drop(&key);
        return child as &AST;
    }

    let ptr = create_node(null, ast.loc, ast.origin);
    let name: String = blank;
    format(&name, "%(%)", parent.name, key);
    ptr.data = ASTData::Function(ASTFunction {
        state: FunctionState {
            is_monomorphized: true,
        },
        loc: ast.loc,
        name: asSubStr(&name),
        scopes: new_GAF_List(type_info(Scope_Info)),
        params: new_GAF_List(type_info(&AST)),
        code: create_code(ptr),
        monomorphized_instances: mapping,
    });
    ptr.attributes = ast.attributes;
    add(&parent.monomorphized_instances, key, ptr);
    parse_function_with_mapping(ptr, mapping);
    message(dbg(ast.loc, "Monomorphized function %", name));
    return ptr;
}

func monomorphize_struct_node(ast: &AST, mapping: GAF_HashMap) -> &AST {
    let &ASTData::Struct(parent) = &ast.data else { unreachable(); };

    let key: String = blank;
    create_mapping_key(&key, &mapping);

    // We've already monomorphized this mapping, we don't need to do any further work
    let child = get(&parent.monomorphized_instances, key);
    if (child.ptr != null) {
        return child as &AST;
    }

    let ptr = create_node(null, ast.loc, ast.origin);
    let name: String = blank;
    format(&name, "%(%)", parent.name, key);
    ptr.data = ASTData::Struct(ASTStruct {
        state: StructState {
            is_monomorphized: true,
        },
        loc: ast.loc,
        name: asSubStr(&name),
        parameters: parent.parameters,
        fields: new_GAF_List(type_info(&AST)),
        monomorphized_instances: mapping,
    });
    add(&parent.monomorphized_instances, key, ptr);
    parse_struct_with_mapping(ptr, mapping);
    message(dbg(ast.loc, "Monomorphized struct %", name));
    return ptr;
}

func __collect_generic_type_mapping(ast: &AST, type: &Type, mapping: &GAF_HashMap) -> bool {
    let maybe_add_mapping = func (mapping: &GAF_HashMap, name: SubStr, type: &Type) -> bool {
        let maybe = get(mapping, name);
        type = wrap_meta_type(type, 1);
        if (maybe.ptr == null) {
            // Mapping doesn't contain $T
            add(mapping, name, type);
        } else {
            // Mapping already contains $T, check if it matches
            let maybe_type = maybe as &Type;
            if (is_unknown(maybe_type)) {
                // We have a better match now (might still be Unknown, but we don't care)
                // Can't use `add()` here because the hash table doesn't overwrite old entries.
                maybe_type = *(maybe.ptr as &&Type) = type;
            }
            if (is_unknown(type)) return true;
            return is_equal_to(maybe_type, type);
        }
        return true;
    };
    match (&ast.data) {
        &ASTData::Function(func_state) => {
            let &BaseType::Func(args, ret) = &type.base else {
                unreachable("__collect_generic_type_mapping: Expected function type");
            };
            if (args.length != func_state.params.length) return false;
            for (let i: usize = 0; i < args.length; i = i + 1) {
                let arg = get_ref(&args, i) as &Type;
                let par = get_ref(&func_state.params, i) as &AST;
                if (!__collect_generic_type_mapping(par, arg, mapping)) {
                    return false;
                }
            }
            return __collect_generic_type_mapping(func_state.return_type, ret, mapping);
        }
        &ASTData::Param(p) => {
            return __collect_generic_type_mapping(p, type, mapping);
        }
        &ASTData::Expr(expr) => {
            match ((expr, type)) {
                (ASTExpr::BuiltinType { name }, ty) => {
                    if (is_unknown(ty)) return true;
                    let bt = ast.type;
                    assert(bt.meta_level != 0, "__collect_generic_type_mapping: Type has no meta level");
                    bt = unwrap_meta_type(bt, 1);
                    return is_equal_to(bt, ty);
                }
                (ASTExpr::Generic, _) => {
                    return maybe_add_mapping(mapping, ast.origin, type);
                }
                (ASTExpr::Unary(ASTUnary::ValueOf(sub)), ty) => {
                    let &BaseType::Ptr(ptr) = &ty.base else {
                        return false;
                    };
                    return __collect_generic_type_mapping(sub, ptr, mapping);
                }
                (ASTExpr::Call(id, args), ty) => {
                    let BaseType::Struct(str) = ty.base else {
                        return false;
                    };
                    let &ASTData::Struct(struct_state) = &str.data else {
                        unreachable("__collect_generic_type_mapping: Expected struct");
                    };
                    assert(struct_state.parameters.length == struct_state.monomorphized_instances.length, "Generic Mapping does not match Generic Param Count");
                    if (args.length != struct_state.monomorphized_instances.length) {
                        return false;
                    }
                    for (let i: usize = 0; i < args.length; i = i + 1) {
                        /*
                         * struct List($T);
                         * func foo(l: List($V));
                         * foo(List(i32));
                         *
                         * call_site_param => $V
                         * struct_def_param => $T
                         * struct_def_type => i32
                         * add to mapping => $V => i32
                         */
                        let call_site_param = get_ref(&args, i) as &AST;
                        let struct_def_param = get_ref(&struct_state.parameters, i) as &AST;
                        let _t = get(&struct_state.monomorphized_instances, struct_def_param.origin);
                        if (_t.ptr == null) return false;
                        let struct_def_type = _t as &Type;
                        struct_def_type = unwrap_meta_type(struct_def_type, 1);
                        if (!maybe_add_mapping(mapping, call_site_param.origin, struct_def_type)) {
                            return false;
                        }
                    }
                    return true;
                }
                (ASTExpr::Ident { _ }, _) => {
                    return false;
                }
                _ => {
                    message(todo(ast.loc, "__collect_generic_type_mapping: % %", expr, *type));
                }
            }
        }
        _ => {
            message(todo(ast.loc, "__collect_generic_type_mapping: %", ast));
        }
    }
    unreachable("__collect_generic_type_mapping");
}
func collect_generic_type_mapping(fn: &AST, type: &Type) -> (GAF_HashMap, bool, bool) {
    let &ASTData::Function(func_state) = &fn.data else {
        unreachable("collect_generic_type_mapping: Expected function");
    };

    let mapping = new_generic_type_mapping();
    let success = __collect_generic_type_mapping(fn, type, &mapping);
    for (let i: usize = 0; i < mapping.capacity; i = i + 1) {
        if (!mapping.set_elements[i]) continue;
        let (k, v) = getAtIndex(&mapping, i);
        let s = k as &SubStr;
        let t = *(v as &&Type);
        if (is_unknown(t)) {
            return (mapping, false, true);
        }
    }
    return (mapping, success, false);
}

@trace func create_function(parent: &AST, loc: Loc, origin: SubStr, name: SubStr) -> &AST {
    let ptr = create_node(parent, loc, origin);
    let scopes = new_GAF_List(type_info(Scope_Info));
    reserve_capacity(&scopes, 16);
    ptr.data = ASTData::Function(ASTFunction {
        state: blank,
        loc: loc,
        name: name,
        scopes: scopes,
        params: new_GAF_List(type_info(&AST)),
        code: create_code(ptr),
        monomorphized_instances: new_hashmap_with_string_key(type_info(&AST)),
    });
    let lookup = get_functions_by_name(&global_lookup, name);
    if (lookup == null) {
        add(&global_lookup.functions, name, new_function_lookup(ptr));
    } else {
        push(&lookup.overloads, ptr);
    }
    return ptr;
}

@trace func create_stmt(parent: &AST, loc: Loc, origin: SubStr, stmt: ASTStmt) -> &AST {
    let ptr = create_node(parent, loc, origin);
    ptr.data = ASTData::Stmt(stmt);
    return ptr;
}

@trace func create_pattern(parent: &AST, loc: Loc, origin: SubStr, pat: ASTPat) -> &AST {
    let ptr = create_node(parent, loc, origin);
    ptr.data = ASTData::Pat(pat);
    return ptr;
}

@trace func create_expr(parent: &AST, loc: Loc, origin: SubStr, expr: ASTExpr) -> &AST {
    let ptr = create_node(parent, loc, origin);
    ptr.data = ASTData::Expr(expr);
    return ptr;
}

@trace func create_directive(parent: &AST, loc: Loc, origin: SubStr, dir: Directive) -> &AST {
    let ptr = create_node(parent, loc, origin);
    ptr.data = ASTData::Directive(dir);
    return ptr;
}
