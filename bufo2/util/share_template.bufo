
import "string.bufo";
import "format.bufo";
import "type_info.bufo";
import "list.bufo";
import "substr.bufo";
import "libc.bufo";

struct Share {
    name: Token;
    content: SubStr;
}

struct Union {
    name: Token;
    content: SubStr;
    shares: GAF_List; // List<SubStr>
}

struct Struct {
    name: Token;
    content: SubStr;
    shares: GAF_List; // List<SubStr>
}

struct Context {
    file_name: SubStr;
    shares: GAF_List; // List<Share>
    structs: GAF_List; // List<Struct>
    unions: GAF_List; // List<Union>
    imports: GAF_List; // List<SubStr>
}

comptime TOKEN_INVALID: usize = 0;
comptime TOKEN_EOF: usize = 1;
comptime TOKEN_IDENT: usize = 2;
comptime TOKEN_STRUCT: usize = 3;
comptime TOKEN_UNION: usize = 4;
comptime TOKEN_SHARED: usize = 5;
comptime TOKEN_STRLIT: usize = 6;
comptime TOKEN_IMPORT: usize = 7;
comptime TOKEN_CURLY_OPEN: usize = 8;
comptime TOKEN_CURLY_CLOSE: usize = 9;
comptime TOKEN_PAREN_OPEN: usize = 10;
comptime TOKEN_PAREN_CLOSE: usize = 11;
comptime TOKEN_COLON: usize = 12;
comptime TOKEN_SEMI_COLON: usize = 13;
comptime TOKEN_COMMA: usize = 14;
comptime TOKEN_AMPERSAND: usize = 15;
struct Token {
    offset_in_file: usize;
    kind: usize;
    content: SubStr;
}
func is_empty(l: &Lexer) -> bool {
    return l.source.len == 0;
}

func next(l: &Lexer) -> Token {
    while (true) {
        let (tkn, is_comment) = next2(l);
        if (!is_comment) return tkn;
    }
    unreachable("next");
}

struct Lexer {
    file_name: SubStr;
    offset_in_file: usize;
    source: SubStr;
}

func next2(l: &Lexer) -> (Token, bool) {
    let advance = func (s: &SubStr, bytes: usize, offset_in_file: &usize) {
        assert(bytes <= s.len, "lexer: advance beyond EOF");
        s.start = s.start + bytes;
        s.len = s.len - bytes;
        *offset_in_file = *offset_in_file + bytes;
    };
    let tkn: Token = blank;
    tkn.kind = TOKEN_EOF;
    if (l.source.len == 0) return (tkn, false);

    let first = l.source.start[0];
    while (isWhitespace(first)) {
        advance(&l.source, 1, &l.offset_in_file);
        first = l.source.start[0];
    }
    tkn.offset_in_file = l.offset_in_file;
    if (l.source.len == 0) return (tkn, false);

    let offset = l.offset_in_file;
    let i: usize = 1;
    if (isAlphabetic(first) || first == '_') {
        while (isAlphanumeric(l.source.start[i]) || l.source.start[i] == '_') i = i + 1;
        let name = substring(&l.source, 0, i);
        let map = [
            (comptime newSubStr("import"), TOKEN_IMPORT),
            (comptime newSubStr("union") , TOKEN_UNION),
            (comptime newSubStr("struct"), TOKEN_STRUCT),
            (comptime newSubStr("shared"), TOKEN_SHARED),
        ];
        let kind = TOKEN_IDENT;
        for (let i: usize = 0; i < map.length; i = i + 1) {
            if (equals(&name, &map[i].0)) {
                kind = map[i].1;
            }
        }
        tkn.kind = kind;
        tkn.content = name;
    } else if (first == '"') {
        let ch = l.source.start[i];
        let escaped = false;
        let s: String = blank;
        while (i < l.source.len && ch != '"') {
            i = i + 1;
            ch = l.source.start[i];
        }
        if (ch != '"') eprint("Unescaped string literal");
        i = i + 1; // closing quote
        tkn.kind = TOKEN_STRLIT;
        tkn.content = substring(&l.source, 0, i);
    } else if (first == '(') {
        tkn.kind = TOKEN_PAREN_OPEN;
    } else if (first == ')') {
        tkn.kind = TOKEN_PAREN_CLOSE;
    } else if (first == '{') {
        tkn.kind = TOKEN_CURLY_OPEN;
    } else if (first == '}') {
        tkn.kind = TOKEN_CURLY_CLOSE;
    } else if (first == ':') {
        tkn.kind = TOKEN_COLON;
    } else if (first == ';') {
        tkn.kind = TOKEN_SEMI_COLON;
    } else if (first == ',') {
        tkn.kind = TOKEN_COMMA;
    } else if (first == '&') {
        tkn.kind = TOKEN_AMPERSAND;
    } else if (first == '/') {
        if (l.source.len > 1 && l.source.start[1] == '*') {
            // /*
            while (true) {
                advance(&l.source, 1, &l.offset_in_file);
                first = l.source.start[0];
                if (l.source.len == 0) return (blank, false);
                let next = l.source.start[1];
                if (first == '*' && next == '/') {
                    break;
                }
            }
            advance(&l.source, 2, &l.offset_in_file); // */
            return (blank, true);
        } else if (l.source.len > 1 && l.source.start[1] == '/') {
            while (first != '\n') {
                advance(&l.source, 1, &l.offset_in_file);
                first = l.source.start[0];
            }
            advance(&l.source, 1, &l.offset_in_file); // Linebreak
            return (blank, true);
        } else {
            eprint("%: error at byte %: Unexpected character `%`.\n", l.file_name, l.offset_in_file, l.source.start[1]);
            return (blank, false);
        }
    } else {
        eprint("%: error at byte %: Unknown character `%`.\n", l.file_name, l.offset_in_file, first);
        C::exit(1);
    }
    advance(&l.source, i, &l.offset_in_file);
    return (tkn, false);
}

func peek(l: &Lexer) -> Token {
    let _l = *l;
    return next(&_l);
}

func at(l: &Lexer, token: usize) -> bool {
    let tkn = peek(l);
    return tkn.kind == token;
}

func eat(l: &Lexer, token: usize) -> bool {
    if (!at(l, token)) return false;
    next(l);
    return true;
}

func expect(l: &Lexer, token: usize) -> Token {
    let tkn = next(l);
    if (tkn.kind == token) return tkn;
    eprint("%: error at byte %: Unexpected token %\n", l.file_name, tkn.offset_in_file, tkn.content);
    C::exit(1);
}

func skip_until_matching(lexer: &Lexer, start: usize, end: usize) -> (Token, Token) {
    let s = expect(lexer, start);
    let count: usize = 1;
    while (count != 0) {
        let tkn = next(lexer);
        if (tkn.kind == start) {
            count = count + 1;
        } else if (tkn.kind == end) {
            count = count - 1;
            if (count == 0) return (s, tkn);
        }
    }
    unreachable("Should've returned by now");
}

func parse_file(file_name: SubStr, file: &String, context: &Context) -> bool {
    let contents = asSubStr(file);
    let lexer = Lexer {
        file_name: context.file_name = file_name,
        offset_in_file: 0,
        source: contents,
    };

    while (!is_empty(&lexer)) {
        let tkn = next(&lexer);
        if (tkn.kind == TOKEN_EOF) break;
        if (tkn.kind == TOKEN_INVALID) return false;
        if (tkn.kind == TOKEN_IMPORT) {
            let file = expect(&lexer, TOKEN_STRLIT);
            expect(&lexer, TOKEN_SEMI_COLON);
            push(&context.imports, file.content);
        } else if (tkn.kind == TOKEN_SHARED) {
            let name = expect(&lexer, TOKEN_IDENT);
            for (let i: usize = 0; i < context.shares.length; i = i + 1) {
                let share: &Share = get_ref_raw(&context.shares, i);
                if (equals(&name.content, &share.name.content)) {
                    eprint("%: error at byte %: Redeclaration of Share `%`.\n", file_name, name.offset_in_file, name.content);
                    eprint("%: note at byte %: Share `%` was already declared here.\n", file_name, share.name.offset_in_file, name.content);
                    return false;
                }
            }
            let (start, end) = skip_until_matching(&lexer, TOKEN_CURLY_OPEN, TOKEN_CURLY_CLOSE);
            let share_ctx = substring(&contents, start.offset_in_file + 1, end.offset_in_file);
            share_ctx = trim(share_ctx);
            let share = Share {
                name: name,
                content: share_ctx,
            };
            push(&context.shares, share);
        } else if (tkn.kind == TOKEN_STRUCT) {
            let name = expect(&lexer, TOKEN_IDENT);
            let shares = new_GAF_List(type_info(SubStr));
            if (eat(&lexer, TOKEN_COLON)) {
                while (!at(&lexer, TOKEN_CURLY_OPEN)) {
                    let share = expect(&lexer, TOKEN_IDENT);
                    if (!at(&lexer, TOKEN_CURLY_OPEN)) {
                        expect(&lexer, TOKEN_COMMA);
                    }
                    push(&shares, share.content);
                }
            }
            let (start, end) = skip_until_matching(&lexer, TOKEN_CURLY_OPEN, TOKEN_CURLY_CLOSE);
            let struct_ctx = substring(&contents, start.offset_in_file + 1, end.offset_in_file);
            struct_ctx = trim(struct_ctx);
            let strukt = Struct {
                name: name,
                shares: shares,
                content: struct_ctx,
            };
            push(&context.structs, strukt);
        } else if (tkn.kind == TOKEN_UNION) {
            let name = expect(&lexer, TOKEN_IDENT);
            let shares = new_GAF_List(type_info(SubStr));
            let (start, end) = skip_until_matching(&lexer, TOKEN_CURLY_OPEN, TOKEN_CURLY_CLOSE);
            let union_ctx = substring(&contents, start.offset_in_file + 1, end.offset_in_file);
            union_ctx = trim(union_ctx);
            let onion = Union {
                name: name,
                shares: shares,
                content: union_ctx,
            };
            push(&context.unions, onion);
        } else {
            eprint("Unhandled top level item `%`\n", tkn.content);
            return false;
        }
    }
    return true;
}

func generate_output(prog: &char, in: &char, out: &char, context: &Context) -> bool {
    let errors = false;
    let out_str = format1("// AUTO-GENERATED BY %!!! DO NOT EDIT!!!\n\n", prog);
    format(&out_str, "// Command line: % % %\n\n", prog, in, out);

    format(&out_str, "// Generated % structure(s)\n", context.structs.length);
    format(&out_str, "// Generated % union(s)\n", context.unions.length);
    format(&out_str, "// Generated % share(s)\n", context.shares.length);
    format(&out_str, "\n");

    if (context.imports.length > 0) {
        format(&out_str, "// -- IMPORTS BEGIN --\n");
        for (let i: usize = 0; i < context.imports.length; i = i + 1) {
            let file: &SubStr = get_ref_raw(&context.imports, i);
            format(&out_str, "import %;\n", *file);
        }
        format(&out_str, "// -- IMPORTS END --\n");
        format(&out_str, "\n");
    }

    if (context.structs.length > 0) {
        format(&out_str, "// -- STRUCTURES BEGIN --\n");
        for (let i: usize = 0; i < context.structs.length; i = i + 1) {
            let strukt: &Struct = get_ref_raw(&context.structs, i);
            format(&out_str, "struct % {\n", strukt.name.content);
            for (let j: usize = 0; j < strukt.shares.length; j = j + 1) {
                let share_name: &SubStr = get_ref_raw(&strukt.shares, j);
                let found = false;
                for (let k: usize = 0; !found && k < context.shares.length; k = k + 1) {
                    let share: &Share = get_ref_raw(&context.shares, k);
                    if (equals(&share.name.content, share_name)) {
                        format(&out_str, "    // Fields from Share `%`\n", *share_name);
                        format(&out_str, "    %\n", share.content);
                        found = true;
                    }
                }
                if (!found) {
                    eprint("%: error at byte %: Structure `%` wants to get the fields of share `%`, but the share doesn't exist.\n", context.file_name, strukt.name.offset_in_file, strukt.name.content, *share_name);
                    errors = true;
                }
            }
            if (strukt.content.len > 0) {
                format(&out_str, "    // Structure fields\n");
                format(&out_str, "    %\n", strukt.content);
            } else {
                format(&out_str, "    // Structure didn't declare any fields itself\n");
            }
            format(&out_str, "} // End of %\n", strukt.name.content);
            if (i != context.structs.length - 1) format(&out_str, "\n");
        }
        format(&out_str, "// -- STRUCTURES END --\n");
        format(&out_str, "\n");
    }

    if (context.unions.length > 0) {
        format(&out_str, "// -- UNIONS BEGIN --\n");
        for (let i: usize = 0; i < context.unions.length; i = i + 1) {
            let onion: &Union = get_ref_raw(&context.unions, i);
            format(&out_str, "union % {\n", onion.name.content);
            if (onion.content.len > 0) {
                format(&out_str, "    // Union variants\n");
                format(&out_str, "    %\n", onion.content);
            } else {
                format(&out_str, "    // Union didn't declare any variants itself\n");
            }
            format(&out_str, "} // End of %\n", onion.name.content);
            if (i != context.unions.length - 1) format(&out_str, "\n");
        }
        format(&out_str, "// -- UNIONS END --\n");
        format(&out_str, "\n");
    }

    format(&out_str, "// END OF AUTO-GENERATED FILE %\n", out);
    if (errors) return false;

    let real_out: String = blank;
    for (let i: usize = 0; i < out_str.length; i = i + 1) {
        let c = out_str.buffer[i];
        if (c == '\r') continue;
        pushChar(&real_out, c);
    }
    writeStringToFile(out, real_out);
    return true;
}

func main(argc: i32, argv: &&char) -> i32 {
    if (argc != 3) {
        eprint("error: Expected input and output file path\n");
        return 1;
    }
    let prog = argv[0];
    let in = argv[1];
    let out = argv[2];
    let file: String = blank;
    if (!canReadFileToString(in, &file)) {
        eprint("error: Could not read input file %\n", in);
        return 1;
    }

    let context = Context {
        shares: new_GAF_List(type_info(Share)),
        structs: new_GAF_List(type_info(Struct)),
        unions: new_GAF_List(type_info(Union)),
        imports: new_GAF_List(type_info(SubStr)),
    };

    if (!parse_file(newSubStr(in), &file, &context)) {
        eprint("error: Could not parse file %\n", in);
        return 1;
    }

    if (!generate_output(prog, in, out, &context)) {
        eprint("error: Could not generate output file\n");
        return 1;
    }

    fprint("Successfully generated output file %\n", out);
    return 0;
}
