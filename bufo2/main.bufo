
import "libc.bufo";
import "type_info.bufo";
import "string.bufo";
import "substr.bufo";
import "format.bufo";
import "time.bufo";

import "common.bufo";
import "corot.bufo";
import "lexer.bufo";
import "parser.bufo";
import "lookup.bufo";

/*
 * spawn(parse_file)
 * parse_file
 * -> spawn(parse_foo)
 * -> spawn(parse_bar)
 * -> spawn(parse_main)
 * parse_foo
 * -> insert
 *    -> run
 *       -> get_ident(bar)
 *          -> no such ident + state == NOT_DONE_PARSING
 *             -> switch()
 *          -> really no such ident
 *             -> report error
 *          -> bind ident, continue
 *       -> code = generate(bar)
 *       -> return call(code)
 *    -> do stuff
 * parse_bar
 * ...
 * parse_main
 * ...
 */

func main(argc: i32, argv: &&char) -> i32 {
    if (argc < 2) {
        C::fprintf(stderr, "error: Expected file input\n");
        return 1;
    }

    let start = get_high_resolution_timestamp();

    init_corot_engine();
    init_global_lookup();

    let file_name = newSubStrOfStrLit(argv[1]);
    let file = spawn(load_file, wrap(Load_Context {
        file_name: file_name,
        loc: new_loc(file_name, 0),
    }));

    // The main function only switches between scheduled coroutines
    while (any_active()) switch();

    let end = get_high_resolution_timestamp();

    let dt = get_duration_between_high_resolution_timestamps_in_microseconds(start, end);
    let ms = dt / 1000;

    fprint("In total, we spawned % coroutine(s).\n", get_corot_count());
    fprint("In total, we took %.%ms.\n", ms, (dt / 10) % 100);

    if (error_happened) {
        C::fprintf(stderr, "error: Could not compile program due to the above errors.\n");
        return 1;
    }
    message(note(blank, "done"));

    return 0;
}

