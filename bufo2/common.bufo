
import "libc.bufo";
import "prelude.bufo";
import "type_info.bufo";
import "substr.bufo";
import "string.bufo";
import "hashmap.bufo";
import "format.bufo";

@if_tracing import "tracy.bufo";

import "corot.bufo";

func wrap(d: Data) -> Any {
    let size = get_size(&d.info);
    let ptr = C::malloc(size);
    assert(ptr != null, "wrap failed");
    C::memcpy(ptr, d.ptr, size);
    return ptr;
}

struct Loc {
    file: SubStr;
    offset: usize; // TODO: line and column
}

func new_loc(file: SubStr, offset: usize) -> Loc {
    return Loc {
        file: file,
        offset: offset,
    };
}

union Message {
    FinalizeError,
    Fatal(Loc, String),
    Todo(Loc, String),
    Error(Loc, String),
    Warning(Loc, String),
    Note(Loc, String),
    Help(Loc, String),
    Debug(Loc, String),
    Info(Loc, String),
}

func finalize_error() -> Message {
    return Message::FinalizeError;
}

func fatal(loc: Loc, fmt: &char, args: ...Data) -> Message {
    return Message::Fatal(loc, format1("% %", FATAL_STR, format1(fmt, args)));
}

func todo(loc: Loc, fmt: &char, args: ...Data) -> Message {
    comptime TODO_STR: &char = "\x1b[95mTODO\x1b[0m";
    return Message::Todo(loc, format1("%: %", TODO_STR, format1(fmt, args)));
}

func error(loc: Loc, fmt: &char, args: ...Data) -> Message {
    return Message::Error(loc, format1("%: %", ERR_STR, format1(fmt, args)));
}

func warn(loc: Loc, fmt: &char, args: ...Data) -> Message {
    return Message::Warning(loc, format1("%: %", WARN_STR, format1(fmt, args)));
}

func note(loc: Loc, fmt: &char, args: ...Data) -> Message {
    return Message::Note(loc, format1("%: %", NOTE_STR, format1(fmt, args)));
}

func help(loc: Loc, fmt: &char, args: ...Data) -> Message {
    comptime HELP_STR: &char = "\x1b[95mhelp\x1b[0m";
    return Message::Help(loc, format1("%: %", HELP_STR, format1(fmt, args)));
}

func dbg(loc: Loc, fmt: &char, args: ...Data) -> Message {
    comptime DEBUG_STR: &char = "\x1b[96mDEBUG\x1b[0m";
    return Message::Debug(loc, format1("%: %", DEBUG_STR, format1(fmt, args)));
}

func info(loc: Loc, fmt: &char, args: ...Data) -> Message {
    comptime INFO_STR: &char = "\x1b[94minfo\x1b[0m";
    return Message::Info(loc, format1("%: %", INFO_STR, format1(fmt, args)));
}
func handle_corot_result(s: Corot_Result, cycle: Message, error: Message) {
    match (s) {
        Corot_Result::Cycle_Detected => { message(cycle); _finish_current(s); }
        Corot_Result::Fucking_Died   => { message(error); _finish_current(s); }
        _ => {}
    }
}

func corot_str(id: Corot_UUID) -> String {
    return format1("[%]", id.id);
}
func corot_str() -> String {
    return corot_str(corot_id());
}

comptime PRINT_DEBUG = false;
let error_happened = false;
let error_ignored = false;
func suppress_exit_on_error() {
    error_ignored = true;
}
func message(errors: ...Message) {
    @if_tracing let ctx = tracy::begin_zone(
        comptime newSubStr("common.bufo"),
        comptime newSubStr("message"),
        comptime newSubStr("Message Handler"));

    let corot = corot_str();
    let had_error = false;
    let fatal_error = false;
    for (let i: usize = 0; i < errors.length; i = i + 1) {
        let loc: Loc = blank;
        let msg: String = blank;
        match (errors[i]) {
            Message::FinalizeError       => {
                error_ignored = false;
                had_error = true;
                break;
            }
            Message::Fatal  (_loc, _msg) => { loc = _loc; msg = _msg; fatal_error = true; }
            Message::Todo   (_loc, _msg) => { loc = _loc; msg = _msg; fatal_error = true; }
            Message::Error  (_loc, _msg) => { loc = _loc; msg = _msg; had_error = true; }
            Message::Warning(_loc, _msg) => { loc = _loc; msg = _msg; }
            Message::Note   (_loc, _msg) => { loc = _loc; msg = _msg; }
            Message::Help   (_loc, _msg) => { loc = _loc; msg = _msg; }
            Message::Info   (_loc, _msg) => { loc = _loc; msg = _msg; }
            Message::Debug  (_loc, _msg) => {
                if (!PRINT_DEBUG) {
                    @if_tracing {
                        tracy::emit_zone_text(ctx, asSubStr(&msg));
                        tracy::end_zone(ctx);
                    }
                    return;
                }
                loc = _loc; msg = _msg;
            }
            _ => { unreachable("message"); }
        }
        if (loc.file.start == null && loc.offset == 0) {
            fprint("% %\n", corot, msg);
        } else {
            fprint("% %:%: %\n", corot, loc.file, loc.offset, msg);
        }
        @if_tracing tracy::emit_zone_text(ctx, asSubStr(&msg));
        drop(&msg);
    }
    drop(&corot);

    @if_tracing tracy::end_zone(ctx);

    if (fatal_error) {
         had_error = true;
         C::exit(2);
    }
    if (!error_ignored && had_error) {
        error_happened = true;
        abort_coroutine();
    }
    error_ignored = false;
}
